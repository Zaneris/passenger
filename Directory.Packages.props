<Project>
  <!-- One version per package for the whole repo; a project's reference names the package only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Roslyn's language server, a package per system downloaded rather than referenced (RoslynServer.targets), so its
         version is a property. Held at 5.11.0, its newest stable release: later builds start Visual Studio Telemetry's
         session even with telemetry off, loading an assembly left out of roslyn/, so the server ends as it starts
         (dotnet/roslyn#86130's fix is in none yet). -->
    <RoslynServerVersion>5.11.0</RoslynServerVersion>
    <!-- Avalonia's dotnet new templates at the Avalonia version below, downloaded for the tests' local feed so no test
         reaches nuget.org for them. -->
    <AvaloniaTemplatesVersion>12.1.4</AvaloniaTemplatesVersion>
    <!-- Avalonia 11's last release, for the previewer's test of an app still on it (tests/AvaloniaGraphs). -->
    <AvaloniaOlderVersion>11.3.22</AvaloniaOlderVersion>
    <!-- Aspire's templates, AppHost SDK and package, dashboard, orchestrator and CLI at one version, downloaded for the
         tests' local feed. -->
    <AspireTemplatesVersion>13.6.3</AspireTemplatesVersion>
    <!-- WPF's reference pack at the version global.json's SDK gives its own WPF (its TargetingPackVersion), downloaded
         for the tests' local feed so the WPF app they make restores off Windows; another SDK's fails WpfXamlTests naming
         the version to pin. A release candidate until .NET 11 ships (then 11.0.0, with the SDK at 11.0.100). -->
    <WindowsDesktopRefVersion>11.0.0-rc.2.26504.105</WindowsDesktopRefVersion>
    <!-- EF Core and the dotnet-ef tool for the Migrations window's tests, downloaded for the tests' local feed: at its
         version, and at the one before for a tool that does not match and a stand-in provider that trails it. -->
    <EfCoreVersion>10.0.13</EfCoreVersion>
    <EfCoreOlderVersion>10.0.12</EfCoreOlderVersion>
    <!-- Npgsql's provider of EF Core, at a version whose range holds EfCoreVersion, for the test of a compose run's
         Postgres. -->
    <NpgsqlEfVersion>10.0.3</NpgsqlEfVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <!-- Also what Passenger's analyzers are compiled against (src/Passenger.Analyzers), so never past the compiler of
         global.json's SDK, nor of Roslyn's server at RoslynServerVersion, which load them. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <!-- The NuGet window's package sources, read by NuGet's own code, so they match the CLI's. -->
    <PackageVersion Include="NuGet.Configuration" Version="7.9.0" />
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <PackageVersion Include="Porta.Pty" Version="2.2.3" />
    <!-- TextMate grammars' tokenizer, with Oniguruma's regular expressions (a native per system): colour for every
         language but C#. -->
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <!-- VSTest's own client for the vstest.console the SDK ships: discovery, runs and debugging of tests. -->
    <PackageVersion Include="Microsoft.TestPlatform.TranslationLayer" Version="18.11.0" />
    <!-- The Windows install's hooks, at the version of the vpk tool that packs it (dotnet-tools.json). -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <!-- The project host (Passenger.Host): MSBuild compiled against at the oldest an SDK it may load carries (8.0.4xx's
       17.11), never copied, and MSBuildLocator at the version Roslyn's own build host uses. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Build" Version="17.11.48" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.10.2" />
  </ItemGroup>
  <!-- The debugger's engine. The expression compiler is Roslyn's, packed from its own source (Roslyn does not
       publish it) at the Microsoft.CodeAnalysis version above, which it must match. -->
  <ItemGroup>
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.2" />
    <PackageVersion Include="Microsoft.Diagnostics.DbgShim" Version="10.0.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageVersion Include="MP.Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" Version="5.9.0" />
    <PackageVersion Include="ZLinq" Version="1.5.6" />
  </ItemGroup>
  <!-- Tests. xunit v3 stays on 3.2, the line Avalonia.Headless.XUnit is built against. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireTemplatesVersion)" />
    <!-- At the versions Aspire's templates at AspireTemplatesVersion write, not their newest, so the test folders made
         from those templates restore from the package cache tests/AspireGraphs fills. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- The analyzers' (src/Passenger.Analyzers): the last release, MIT where netstandard2.0's 1.1.0 is not. -->
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
