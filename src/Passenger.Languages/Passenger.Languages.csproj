<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the UI knows of a language before any language server answers: colour from a parser
       that runs in-process, off the UI thread. -->
  <PropertyGroup>
    <RootNamespace>Passenger.Languages</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Tint" />
    <ProjectReference Include="../Passenger.Editor/Passenger.Editor.csproj" />
    <ProjectReference Include="../Passenger.Lsp/Passenger.Lsp.csproj" />
    <ProjectReference Include="../Passenger.Text/Passenger.Text.csproj" />
  </ItemGroup>

  <!-- VS Code's TextMate grammars and dotnet/roslyn's Razor and C# ones, unchanged (THIRD_PARTY_NOTICES.md says where each
       came from), read by their file name. -->
  <ItemGroup>
    <EmbeddedResource Include="TextMate/Grammars/*.json" LogicalName="Grammars/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
