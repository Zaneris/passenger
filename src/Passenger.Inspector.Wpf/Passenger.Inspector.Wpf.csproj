<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger's inspector inside a WPF app it runs or debugs (the Live Visual Tree, binding errors, an agent's app tools),
       WPF's counterpart of Passenger.Inspector: the runtime loads it as a startup hook (DOTNET_STARTUP_HOOKS) into a run
       Passenger launches, never into the app as built or shipped, and it answers over the socket Passenger names, on the
       app's UI thread, in the same protocol (Protocol.cs). Built on every system (EnableWindowsTargeting), so a change that
       breaks it fails every build, and carried under inspector/wpf/ only by Passenger's Windows builds, where WPF runs. -->
  <PropertyGroup>
    <!-- The oldest .NET a WPF app Passenger runs is on (CoreCLR alone), so it loads into any of them. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Passenger.Inspector.Wpf</RootNamespace>
    <!-- Never optimized, a Release build as a Debug one: the debugger reads a binding error's argument where the app stops. -->
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF's implicit usings leave System.IO out, for its Path beside System.Windows.Shapes.Path, which nothing here uses. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Passenger and its inspectors say to each other, and the app's end of the socket, one definition for all. -->
    <Compile Include="../Passenger.Inspector/Protocol.cs" Link="Protocol.cs" />
    <Compile Include="../Passenger.Inspector/Connection.cs" Link="Connection.cs" />
    <!-- A property breakpoint's hit count is kept here, where its changes are seen, in the debugger's own words. -->
    <Compile Include="../Passenger.Dap/HitCondition.cs" Link="HitCondition.cs" />
  </ItemGroup>
</Project>
