<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger's inspector inside a WPF app it runs or debugs (the Live Visual Tree, binding errors, an agent's app
       tools): the runtime loads it as a startup hook (DOTNET_STARTUP_HOOKS) into a run Passenger launches, never into
       the app as built or shipped, and it answers over the socket Passenger names, on the app's UI thread
       (Protocol.cs). Built on every system (EnableWindowsTargeting), so a change that breaks it fails every build, and
       carried under inspector/wpf/ only by Passenger's Windows builds, where WPF runs. -->
  <PropertyGroup>
    <!-- The oldest .NET a WPF app Passenger runs is on (CoreCLR alone), so it loads into any of them. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Passenger.Inspector.Wpf</RootNamespace>
    <!-- Never optimized, a Release build as a Debug one: the debugger reads a binding error's argument where the app stops. -->
    <Optimize>false</Optimize>
    <!-- PathNames asks Windows for a file's own name into a buffer it fixes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF's implicit usings leave System.IO out, for its Path beside System.Windows.Shapes.Path, which nothing here uses. -->
    <Using Include="System.IO" />
    <!-- What the linked Breaks.cs hands the debugger: WPF's own element and property. -->
    <Using Include="System.Windows.DependencyObject" Alias="InspectedObject" />
    <Using Include="System.Windows.DependencyProperty" Alias="InspectedProperty" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Passenger and its inspectors say to each other, and the app's end of the socket, one definition for all. -->
    <Compile Include="../Passenger.Inspector/Protocol.cs" Link="Protocol.cs" />
    <Compile Include="../Passenger.Inspector/Connection.cs" Link="Connection.cs" />
    <Compile Include="../Passenger.Core/JsonLines.cs" Link="JsonLines.cs" />
    <!-- The serve loop, the request switch and the words both inspectors answer in, and where the debugger stops them. -->
    <Compile Include="../Passenger.Inspector/Serving.cs" Link="Serving.cs" />
    <Compile Include="../Passenger.Inspector/Breaks.cs" Link="Breaks.cs" />
    <!-- The failed bindings told and counted, and a failure's nearest names, one definition for both inspectors. -->
    <Compile Include="../Passenger.Inspector/BindingFailures.cs" Link="BindingFailures.cs" />
    <Compile Include="../Passenger.Core/Spelling.cs" Link="Spelling.cs" />
    <!-- The runtime's variables, and the startup hooks' rule (this hook first, taken out as it starts, out of the process's
         own environment too), as Passenger names them. -->
    <Compile Include="../Passenger.Core/RuntimeVariables.cs" Link="RuntimeVariables.cs" />
    <Compile Include="../Passenger.Core/StartupHooks.cs" Link="StartupHooks.cs" />
    <Compile Include="../Passenger.Core/OwnEnvironment.cs" Link="OwnEnvironment.cs" />
    <!-- A XAML file's path as the disk names it, as the rest of Passenger reads one. -->
    <Compile Include="../Passenger.Core/PathNames.cs" Link="PathNames.cs" />
    <Compile Include="../Passenger.Core/PathComparer.cs" Link="PathComparer.cs" />
    <!-- A property breakpoint's hit count is kept here, where its changes are seen, in the debugger's own words. -->
    <Compile Include="../Passenger.Dap/HitCondition.cs" Link="HitCondition.cs" />
  </ItemGroup>
</Project>
