<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger's inspector inside an Avalonia app it debugs (the Live Visual Tree): the runtime loads it as a startup
       hook (DOTNET_STARTUP_HOOKS) into a run Passenger launches, never into the app as built or shipped, and it answers
       over the socket Passenger names, on the app's UI thread. Carried under inspector/ beside Passenger, its own
       assembly and XAML Hot Reload's compiler alone, as the app's Avalonia must be the one it uses. -->
  <PropertyGroup>
    <!-- The oldest .NET an Avalonia 12 app runs on, so it loads into any of them. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Passenger.Inspector</RootNamespace>
    <!-- Never optimized, a Release build as a Debug one: the debugger reads a property breakpoint's arguments where the app
         stops (its condition's, what changed), which optimized code need not keep. -->
    <Optimize>false</Optimize>
    <!-- The frame events are written as EventSource's fast path writes them, from the stack (Frames.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled against Avalonia's implementation assemblies, not the reference ones the package gives a build: those
         leave out what Avalonia marks [PrivateApi], among it the value store's diagnostics (which frame gave a value,
         which style it is, whether it is active) and a popup's host. -->
    <PackageReference Include="Avalonia" GeneratePathProperty="true" ExcludeAssets="compile" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/Avalonia.Base.dll" Private="false" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/Avalonia.Controls.dll" Private="false" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/Avalonia.Markup.dll" Private="false" />
    <Reference Include="$(PkgAvalonia)/lib/net8.0/Avalonia.Markup.Xaml.dll" Private="false" />
    <!-- XAML Hot Reload's runtime compiler, carried beside the inspector for an app that does not have its own
         (AppAvaloniaContext). -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" GeneratePathProperty="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Breaks.cs, linked into both inspectors, hands the debugger: Avalonia's own control and property. -->
    <Using Include="Avalonia.AvaloniaObject" Alias="InspectedObject" />
    <Using Include="Avalonia.AvaloniaProperty" Alias="InspectedProperty" />
  </ItemGroup>

  <ItemGroup>
    <!-- A property breakpoint's hit count is kept here, where its changes are seen, in the debugger's own words. -->
    <Compile Include="../Passenger.Dap/HitCondition.cs" Link="HitCondition.cs" />
    <!-- A failed binding's nearest names, measured as the rest of Passenger measures a misspelling. -->
    <Compile Include="../Passenger.Core/Spelling.cs" Link="Spelling.cs" />
    <!-- The runtime's variables, and the startup hooks' rule (this hook first, taken out as it starts, out of the process's
         own environment too), as Passenger names them. -->
    <Compile Include="../Passenger.Core/RuntimeVariables.cs" Link="RuntimeVariables.cs" />
    <Compile Include="../Passenger.Core/StartupHooks.cs" Link="StartupHooks.cs" />
    <Compile Include="../Passenger.Core/OwnEnvironment.cs" Link="OwnEnvironment.cs" />
    <!-- Passenger's requests read as every JSON-lines peer reads its messages. -->
    <Compile Include="../Passenger.Core/JsonLines.cs" Link="JsonLines.cs" />
    <!-- C#'s keywords for the types of the values shown. -->
    <Compile Include="../Passenger.Core/PrimitiveTypes.cs" Link="PrimitiveTypes.cs" />
    <!-- A XAML file's path compared with where the app's build recorded it, as the rest of Passenger compares paths. -->
    <Compile Include="../Passenger.Core/PathNames.cs" Link="PathNames.cs" />
    <Compile Include="../Passenger.Core/PathComparer.cs" Link="PathComparer.cs" />
  </ItemGroup>

  <!-- What Passenger carries under inspector/ beside the inspector's own assembly: XAML Hot Reload's compiler. -->
  <Target Name="GetCarriedFiles" Returns="@(CarriedFile)">
    <ItemGroup>
      <CarriedFile Include="$(PkgAvalonia_Markup_Xaml_Loader)/lib/net8.0/Avalonia.Markup.Xaml.Loader.dll" />
    </ItemGroup>
  </Target>
</Project>
