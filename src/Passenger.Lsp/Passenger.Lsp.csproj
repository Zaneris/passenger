<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Language Server Protocol client, and the Roslyn language server it runs. -->
  <PropertyGroup>
    <RootNamespace>Passenger.Lsp</RootNamespace>
  </PropertyGroup>

  <!-- Microsoft's server (MIT, built in the Roslyn repo), one package per platform, copied beside the app under roslyn/;
       RoslynServer.targets finds it. -->
  <Import Project="RoslynServer.targets" />
  <PropertyGroup>
    <!-- Keep the publish's server identity when the extension's portable build drops RuntimeIdentifier. -->
    <RoslynExtensionProperties Condition="'$(RuntimeIdentifier)' != ''">RoslynServerFor=$(RoslynServerFor)</RoslynExtensionProperties>
  </PropertyGroup>
  <!-- The servers for JavaScript, TypeScript, HTML, CSS and JSON, npm packages carried under web/; WebServers.targets puts
       them in place with tools/Passenger.NodePackages, built first and run, never linked. -->
  <Import Project="WebServers.targets" />
  <ItemGroup>
    <ProjectReference Include="../../tools/Passenger.NodePackages/Passenger.NodePackages.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled against here alone: a server's failure reaches the app as a LanguageServerFailed, never as one of its exceptions. -->
    <PackageReference Include="StreamJsonRpc" PrivateAssets="compile;contentfiles;analyzers;build" />
    <ProjectReference Include="../Passenger.Core/Passenger.Core.csproj" />
    <ProjectReference Include="../Passenger.Text/Passenger.Text.csproj" />
    <!-- Built first and carried under roslyn-extension/, never linked: the server loads it (RoslynExtension.cs). It is
         built once for every platform, as the server's own assemblies it is compiled against are the same on each. -->
    <ProjectReference Include="../Passenger.Roslyn.Extension/Passenger.Roslyn.Extension.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun" AdditionalProperties="$(RoslynExtensionProperties)" />
    <!-- The extension's messages, one definition for both ends. -->
    <Compile Include="../Passenger.Roslyn.Extension/Messages.cs" Link="RefactoringMessages.cs" />
    <Compile Include="../Passenger.Roslyn.Extension/ProjectMessages.cs" Link="ProjectMessages.cs" />
    <Compile Include="../Passenger.Roslyn.Extension/HotReloadMessages.cs" Link="HotReloadMessages.cs" />
  </ItemGroup>

  <!-- For the app's notices of what it carries: the server's package folder (Kind package, with the folder it runs from
       as Folder) and the packages whose assemblies are left out of roslyn/ (Kind leftOut). -->
  <Target Name="GetRoslynServer" DependsOnTargets="FindRoslynServer" Returns="@(RoslynServerForNotices)">
    <ItemGroup>
      <RoslynServerForNotices Include="$(RoslynServerPackage)" Kind="package" Folder="$(RoslynServerFolder)" />
      <RoslynServerForNotices Include="@(RoslynServerLeftOut)" Kind="leftOut" />
    </ItemGroup>
  </Target>

  <!-- The server's files become this project's output items, so every project that references this
       one (the app, the tests) gets them beside its own binaries, with the package's third-party notices. -->
  <Target Name="IncludeRoslynServer" BeforeTargets="AssignTargetPaths" DependsOnTargets="FindRoslynServer">
    <ItemGroup>
      <RoslynServerNotices Include="$(RoslynServerPackage)ThirdPartyNotices.*" />
    </ItemGroup>
    <Error Condition="'@(RoslynServerNotices)' == ''"
           Text="roslyn-language-server.$(RoslynServerRid) $(RoslynServerVersion) has no ThirdPartyNotices file at its root, which Passenger carries beside the server." />
    <ItemGroup>
      <RoslynServerLeftOutGone Include="@(RoslynServerLeftOut)" Condition="!Exists('$(RoslynServerFolder)%(Identity).dll')" />
    </ItemGroup>
    <Error Condition="'@(RoslynServerLeftOutGone)' != ''"
           Text="roslyn-language-server.$(RoslynServerRid) $(RoslynServerVersion) no longer carries @(RoslynServerLeftOutGone->'%(Identity).dll', ', '), which Passenger leaves out: check again what the server loads, then the list and THIRD_PARTY_NOTICES.md." />
    <ItemGroup>
      <!-- The package's files only: a server run from the package folder leaves its MEF cache in cache/ there. -->
      <RoslynServerFile Include="$(RoslynServerFolder)**/*"
                        Exclude="$(RoslynServerFolder)cache/**;@(RoslynServerLeftOut->'$(RoslynServerFolder)%(Identity).dll');@(RoslynServerLeftOut->'$(RoslynServerFolder)*/%(Identity).resources.dll')" />
      <None Include="@(RoslynServerFile)" Link="roslyn/%(RoslynServerFile.RecursiveDir)%(RoslynServerFile.Filename)%(RoslynServerFile.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="@(RoslynServerNotices)" Link="roslyn/%(RoslynServerNotices.Filename)%(RoslynServerNotices.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Passenger's own extension to the server becomes this project's output under roslyn-extension/, as the server's files
       do under roslyn/: a folder of its own, since the server loads an extension's folder into a context of its own and
       Roslyn's assemblies must come from the server's. -->
  <Target Name="IncludeRoslynExtension" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="../Passenger.Roslyn.Extension/Passenger.Roslyn.Extension.csproj" Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun" Properties="$(RoslynExtensionProperties)" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="RoslynExtensionAssembly" />
    </MSBuild>
    <ItemGroup>
      <RoslynExtensionFile Include="@(RoslynExtensionAssembly->'%(RootDir)%(Directory)%(Filename).dll');@(RoslynExtensionAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <None Include="@(RoslynExtensionFile)" Link="roslyn-extension/%(RoslynExtensionFile.Filename)%(RoslynExtensionFile.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
