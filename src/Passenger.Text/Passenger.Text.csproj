<Project Sdk="Microsoft.NET.Sdk">
  <!-- Text with no UI: the rope, documents, undo, carets and every editing operation, and a file's text as it is stored
       (its encoding, its .editorconfig, its one way of being saved). -->
  <PropertyGroup>
    <RootNamespace>Passenger.Text</RootNamespace>
    <!-- A save keeps a macOS file's extended attributes and ACL through libc's copyfile, a generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- AtomicFile, which every save writes through. -->
    <ProjectReference Include="../Passenger.Core/Passenger.Core.csproj" />
  </ItemGroup>
</Project>
