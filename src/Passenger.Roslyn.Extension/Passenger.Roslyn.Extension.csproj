<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger's extension to Roslyn's language server, loaded into the server's process: message handlers over the
       solution the server has open, and the server's projects loaded from Passenger's project host. It is compiled against
       the very assemblies the shipped server carries, never a package of its own, so it calls the API the server runs; it
       carries none of them, since the server's must be the ones it uses. -->
  <PropertyGroup>
    <!-- The server's: the extension runs in its process, on whichever runtime runs it. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Passenger.Roslyn.Extension</RootNamespace>
    <!-- Roslyn marks its extension message handlers experimental. -->
    <NoWarn>$(NoWarn);RSEXPERIMENTAL008</NoWarn>
    <!-- PathNames asks Windows for a file's own name into a buffer it fixes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paths compared, Razor files named and names listed in words as the rest of Passenger does, compiled in since
         Passenger.Core's net11.0 is past the server's. -->
    <Compile Include="../Passenger.Core/PathNames.cs" Link="PathNames.cs" />
    <Compile Include="../Passenger.Core/PathComparer.cs" Link="PathComparer.cs" />
    <Compile Include="../Passenger.Core/RazorFiles.cs" Link="RazorFiles.cs" />
    <Compile Include="../Passenger.Core/Plural.cs" Link="Plural.cs" />
  </ItemGroup>

  <Import Project="../Passenger.Lsp/RoslynServer.targets" />

  <Target Name="ReferenceRoslynServer" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="FindRoslynServer">
    <ItemGroup>
      <RoslynServerAssembly Include="Microsoft.CodeAnalysis;Microsoft.CodeAnalysis.CSharp;Microsoft.CodeAnalysis.Workspaces;Microsoft.CodeAnalysis.CSharp.Workspaces;Microsoft.CodeAnalysis.ExternalAccess.Extensions" />
      <!-- Edit and Continue (HotReload.cs): the server's own EnC service, kept internal, made public to compile against below. -->
      <RoslynServerAssembly Include="Microsoft.CodeAnalysis.Features" />
      <!-- The project system the loader joins: the server's own, kept internal, made public to compile against below. -->
      <RoslynServerAssembly Include="Microsoft.CodeAnalysis.LanguageServer;Microsoft.CodeAnalysis.LanguageServer.Protocol;Microsoft.CodeAnalysis.Workspaces.MSBuild;Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts;Microsoft.Extensions.Logging.Abstractions;System.Composition.AttributedModel" />
      <Reference Include="@(RoslynServerAssembly->'$(RoslynServerFolder)%(Identity).dll')" Private="false" />
    </ItemGroup>
  </Target>

  <!-- The server's project loader, its LSP services and handlers, and the build host's contracts are internal to it. -->
  <ItemGroup>
    <Publicize Include="Microsoft.CodeAnalysis.LanguageServer" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.LanguageServer.Protocol" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.Workspaces" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Microsoft.CodeAnalysis.Features" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <Import Project="../Publicize.targets" />

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
