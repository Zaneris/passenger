<Project Sdk="Microsoft.NET.Sdk">
  <!-- The code editor control and the keymap. Draws Passenger.Text's documents; knows nothing of
       files, languages or the IDE around it. -->
  <PropertyGroup>
    <RootNamespace>Passenger.Editor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- InFlight, whose watch names background work's holds. -->
    <ProjectReference Include="../Passenger.Core/Passenger.Core.csproj" />
    <ProjectReference Include="../Passenger.Text/Passenger.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Fonts/*.ttf" />
  </ItemGroup>

  <!-- The theme's keys as constants for the editor, the IDE and the tests (Passenger.Analyzers' ResourceKeys), read from the
       XAML that gives them: TokenKeys every Passenger.* key, IconKeys every Icon.* one. -->
  <ItemGroup>
    <AdditionalFiles Include="../Passenger.App/Theme/Tokens.axaml;../Passenger.App/Theme/ControlThemes.axaml;../Passenger.App/Theme/Shell.axaml"
                     KeysClass="TokenKeys" KeysPrefix="Passenger." />
    <AdditionalFiles Include="../Passenger.App/Theme/Icons.axaml" KeysClass="IconKeys" KeysPrefix="Icon." />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="KeysClass" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="KeysPrefix" />
  </ItemGroup>
</Project>
