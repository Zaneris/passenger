<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="using:Passenger.App.Navigation"
             x:Class="Passenger.App.Navigation.GoToFilePopup"
             Width="640">
    <Border Classes="popup">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8" Spacing="8">
                <TextBlock Classes="paneTitle" Text="Go to File" />
                <TextBox Name="Query" Classes="search" PlaceholderText="File name, CamelHumps or a path with /" />
            </StackPanel>
            <TextBlock Name="Empty" DockPanel.Dock="Top" Classes="muted" Margin="12,0,12,12" IsVisible="False" />
            <ListBox Name="Results" Classes="tree" MaxHeight="384" Margin="0,0,0,8" DoubleTapped="OnResultDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="nav:FileHit">
                        <Grid ColumnSpacing="8" Height="24" ToolTip.Tip="{Binding FullPath}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="{Binding FolderWidth}" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Data="{Binding Icon}" Foreground="{Binding IconBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Classes="muted" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
