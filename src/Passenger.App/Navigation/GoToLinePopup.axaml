<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Passenger.App"
             x:Class="Passenger.App.Navigation.GoToLinePopup"
             Width="{x:Static app:PopupFrame.Narrow}">
    <Border Classes="popup" Padding="{x:Static app:PopupFrame.Inset}">
        <StackPanel Spacing="{x:Static app:Gaps.Normal}">
            <TextBlock Classes="paneTitle" Text="Go to Line:Column" />
            <TextBox Name="Query" AutomationProperties.Name="Go to Line:Column" />
            <TextBlock Name="Problem" Classes="muted caption" IsVisible="False" />
        </StackPanel>
    </Border>
</UserControl>
