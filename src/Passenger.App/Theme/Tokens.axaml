<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every colour the IDE paints, once per theme. A control names a token, never a colour, so a
         theme is this file and nothing else. Passenger.Editor.* and Passenger.Syntax.* are read by the
         code editor by name; a syntax kind left out draws as plain text. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Passenger.Chrome" Color="#2B2D30" />
            <SolidColorBrush x:Key="Passenger.Field" Color="#1E1F22" />
            <SolidColorBrush x:Key="Passenger.FieldBorder" Color="#4E5157" />
            <SolidColorBrush x:Key="Passenger.Button" Color="#393B40" />
            <SolidColorBrush x:Key="Passenger.DropZone" Color="#3D7BF5" Opacity="0.18" />
            <SolidColorBrush x:Key="Passenger.Divider" Color="#1E1F22" />
            <!-- A rule between groups inside a page (Rider's Separator.separatorColor), which shows on the field's colour where
                 the Divider, the field's own colour in dark, does not. -->
            <SolidColorBrush x:Key="Passenger.Separator" Color="#393B40" />
            <!-- A kind badge's letter (Go to Symbol, completion), on the badge's syntax colour: dark on dark's light colours, light on
                 light's dark ones. -->
            <SolidColorBrush x:Key="Passenger.BadgeText" Color="#1E1F22" />
            <!-- An unticked check box's edge: clearer than a field's, so it shows on a selected row's blue and in light. -->
            <SolidColorBrush x:Key="Passenger.CheckBorder" Color="#6F737A" />
            <SolidColorBrush x:Key="Passenger.Text" Color="#DFE1E5" />
            <SolidColorBrush x:Key="Passenger.TextMuted" Color="#868A91" />
            <SolidColorBrush x:Key="Passenger.Icon" Color="#CED0D6" />
            <SolidColorBrush x:Key="Passenger.Hover" Color="#393B40" />
            <!-- The merged title bar's window buttons, Rider's on Windows (JetBrains' title pane buttons' colours), and the edge
                 Linux shows round a window that draws its own frame. -->
            <SolidColorBrush x:Key="Passenger.WindowButton.Hover" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Passenger.WindowButton.Pressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="Passenger.WindowButton.CloseHover" Color="#E81123" />
            <SolidColorBrush x:Key="Passenger.WindowButton.ClosePressed" Color="#F1707A" />
            <SolidColorBrush x:Key="Passenger.WindowButton.CloseGlyph" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Passenger.WindowEdge" Color="#43454A" />
            <!-- The line between a stripe's upper and lower windows, plainer than a hover but not a border. -->
            <SolidColorBrush x:Key="Passenger.StripeSeparator" Color="#55585E" />
            <SolidColorBrush x:Key="Passenger.Selected" Color="#43454A" />
            <SolidColorBrush x:Key="Passenger.RowSelected" Color="#2E436E" />
            <SolidColorBrush x:Key="Passenger.Accent" Color="#3D7BF5" />
            <SolidColorBrush x:Key="Passenger.AccentHover" Color="#5A8FF7" />
            <SolidColorBrush x:Key="Passenger.AccentText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Passenger.Link" Color="#548AF7" />
            <SolidColorBrush x:Key="Passenger.LinkHover" Color="#7AA4F9" />
            <SolidColorBrush x:Key="Passenger.Run" Color="#5FAD65" />
            <SolidColorBrush x:Key="Passenger.HotReload" Color="#E08855" />
            <SolidColorBrush x:Key="Passenger.Test.Passed" Color="#5FAD65" />
            <SolidColorBrush x:Key="Passenger.Test.Failed" Color="#E55765" />
            <SolidColorBrush x:Key="Passenger.Test.Skipped" Color="#868A91" />
            <SolidColorBrush x:Key="Passenger.Test.Running" Color="#5E9CF0" />
            <SolidColorBrush x:Key="Passenger.Test.NotRun" Color="#6F737A" />
            <SolidColorBrush x:Key="Passenger.Vcs.Added" Color="#549159" />
            <SolidColorBrush x:Key="Passenger.Vcs.Modified" Color="#375FAD" />
            <SolidColorBrush x:Key="Passenger.Vcs.Deleted" Color="#868A91" />
            <SolidColorBrush x:Key="Passenger.Vcs.Conflict" Color="#C75450" />
            <SolidColorBrush x:Key="Passenger.Banner" Color="#2E3440" />
            <SolidColorBrush x:Key="Passenger.Editor.Bookmark" Color="#548AF7" />
            <SolidColorBrush x:Key="Passenger.Diff.Added" Color="#2B4234" />
            <SolidColorBrush x:Key="Passenger.Diff.Modified" Color="#2C3A55" />
            <SolidColorBrush x:Key="Passenger.Diff.Deleted" Color="#3B3D42" />
            <SolidColorBrush x:Key="Passenger.Diff.Conflict" Color="#482D2E" />
            <!-- The words that changed inside a diff's changed lines, over the lines' tint. -->
            <SolidColorBrush x:Key="Passenger.Diff.AddedWord" Color="#3D6B4A" />
            <SolidColorBrush x:Key="Passenger.Diff.ModifiedWord" Color="#405A8C" />
            <SolidColorBrush x:Key="Passenger.Diff.DeletedWord" Color="#55585E" />
            <SolidColorBrush x:Key="Passenger.Diff.ConflictWord" Color="#6E3B3D" />
            <SolidColorBrush x:Key="Passenger.Graph.0" Color="#3574F0" />
            <SolidColorBrush x:Key="Passenger.Graph.1" Color="#5FAD65" />
            <SolidColorBrush x:Key="Passenger.Graph.2" Color="#E2A33F" />
            <SolidColorBrush x:Key="Passenger.Graph.3" Color="#A57EE3" />
            <SolidColorBrush x:Key="Passenger.Graph.4" Color="#DB5C5C" />
            <SolidColorBrush x:Key="Passenger.Graph.5" Color="#3FB3B3" />
            <SolidColorBrush x:Key="Passenger.Vcs.Ref" Color="#3A3D45" />
            <!-- A favourite branch's star in the Git log's branches. -->
            <SolidColorBrush x:Key="Passenger.Vcs.Favorite" Color="#E2A33F" />
            <!-- The colour picker's rings over the colour chosen, and the checkerboard behind what is clear: the same in
                 both themes, as they stand on the colours being chosen rather than the window's. -->
            <SolidColorBrush x:Key="Passenger.Picker.RingInner" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Passenger.Picker.RingOuter" Color="#000000" />
            <SolidColorBrush x:Key="Passenger.Picker.Checker" Color="#CCCCCC" />
            <SolidColorBrush x:Key="Passenger.Vcs.RefText" Color="#C9CCD6" />
            <SolidColorBrush x:Key="Passenger.Terminal.Foreground" Color="#CED0D6" />
            <SolidColorBrush x:Key="Passenger.Terminal.Background" Color="#1E1F22" />
            <SolidColorBrush x:Key="Passenger.Terminal.Cursor" Color="#CED0D6" />
            <SolidColorBrush x:Key="Passenger.Terminal.Selection" Color="#214283" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi0" Color="#3F4148" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi1" Color="#F0524F" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi2" Color="#5C962C" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi3" Color="#A68A0D" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi4" Color="#3993D4" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi5" Color="#A771BF" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi6" Color="#00A3A3" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi7" Color="#9DA0A8" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi8" Color="#5F636B" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi9" Color="#FF4050" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi10" Color="#4FC414" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi11" Color="#E5BF00" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi12" Color="#1FB0FF" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi13" Color="#ED7EED" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi14" Color="#00E5E5" />
            <SolidColorBrush x:Key="Passenger.Terminal.Ansi15" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Passenger.Vcs.File.Modified" Color="#6897BB" />
            <SolidColorBrush x:Key="Passenger.Vcs.File.Added" Color="#629755" />
            <SolidColorBrush x:Key="Passenger.Vcs.File.Deleted" Color="#6C6C6C" />
            <SolidColorBrush x:Key="Passenger.Vcs.File.Unversioned" Color="#D1675A" />
            <SolidColorBrush x:Key="Passenger.Vcs.File.Conflicted" Color="#D5756C" />
            <SolidColorBrush x:Key="Passenger.Badge" Color="#4A6FA8" />
            <SolidColorBrush x:Key="Passenger.Modified" Color="#6F9BF5" />

            <SolidColorBrush x:Key="Passenger.File.Folder" Color="#AEB4BF" />
            <SolidColorBrush x:Key="Passenger.File.SolutionFolder" Color="#9F92DB" />
            <SolidColorBrush x:Key="Passenger.File.CSharp" Color="#B48BFF" />
            <SolidColorBrush x:Key="Passenger.File.Project" Color="#6FBF73" />
            <SolidColorBrush x:Key="Passenger.File.Xml" Color="#E8975A" />
            <SolidColorBrush x:Key="Passenger.File.Json" Color="#D9BC5F" />
            <SolidColorBrush x:Key="Passenger.File.Markdown" Color="#6FA3EB" />
            <SolidColorBrush x:Key="Passenger.File.Code" Color="#5FB7C2" />
            <SolidColorBrush x:Key="Passenger.File.Plain" Color="#AEB4BF" />

            <SolidColorBrush x:Key="Passenger.Editor.Background" Color="#1E1F22" />
            <SolidColorBrush x:Key="Passenger.Editor.Gutter" Color="#1E1F22" />
            <SolidColorBrush x:Key="Passenger.Editor.Text" Color="#BCBEC4" />
            <SolidColorBrush x:Key="Passenger.Editor.LineNumber" Color="#4B5059" />
            <SolidColorBrush x:Key="Passenger.Editor.LineNumberCurrent" Color="#A1A3AB" />
            <SolidColorBrush x:Key="Passenger.Editor.CurrentLine" Color="#26282E" />
            <SolidColorBrush x:Key="Passenger.Editor.Selection" Color="#214283" />
            <SolidColorBrush x:Key="Passenger.Editor.SelectionInactive" Color="#2C3341" />
            <SolidColorBrush x:Key="Passenger.Editor.Caret" Color="#CED0D6" />
            <SolidColorBrush x:Key="Passenger.Editor.SearchMatch" Color="#2F4A36" />
            <SolidColorBrush x:Key="Passenger.Editor.Error" Color="#F75464" />
            <SolidColorBrush x:Key="Passenger.Editor.Warning" Color="#E5A336" />
            <SolidColorBrush x:Key="Passenger.Editor.Info" Color="#8A8F97" />
            <SolidColorBrush x:Key="Passenger.Editor.SearchCurrent" Color="#4F9A5F" />
            <SolidColorBrush x:Key="Passenger.Editor.Breakpoint" Color="#E55765" />
            <SolidColorBrush x:Key="Passenger.Editor.BreakpointLine" Color="#3A2627" />
            <SolidColorBrush x:Key="Passenger.Editor.ExecutionLine" Color="#253553" />
            <SolidColorBrush x:Key="Passenger.Editor.InlineValue" Color="#868A91" />
            <SolidColorBrush x:Key="Passenger.Editor.Tracepoint" Color="#E5A336" />
            <SolidColorBrush x:Key="Passenger.Editor.BreakpointMuted" Color="#CED0D6" />
            <SolidColorBrush x:Key="Passenger.Editor.ExceptionBack" Color="#4A2629" />
            <SolidColorBrush x:Key="Passenger.Editor.InlayHint" Color="#8F9298" />
            <SolidColorBrush x:Key="Passenger.Editor.InlayHintBack" Color="#2B2D30" />
            <SolidColorBrush x:Key="Passenger.Editor.ExecutionPoint" Color="#5E9CF0" />
            <SolidColorBrush x:Key="Passenger.Editor.UsageRead" Color="#373B39" />
            <SolidColorBrush x:Key="Passenger.Editor.UsageWrite" Color="#402F33" />
            <SolidColorBrush x:Key="Passenger.Editor.UsageReadMark" Color="#5B786A" />
            <SolidColorBrush x:Key="Passenger.Editor.UsageWriteMark" Color="#BA6387" />
            <SolidColorBrush x:Key="Passenger.Editor.MatchedBrace" Color="#43454A" />
            <!-- Rider Dark's DEBUGGER_SMART_STEP_INTO_TARGET and _SELECTION (its effect colour the box). -->
            <SolidColorBrush x:Key="Passenger.Editor.SmartStepTarget" Color="#53385E" />
            <SolidColorBrush x:Key="Passenger.Editor.SmartStepChosen" Color="#824991" />
            <SolidColorBrush x:Key="Passenger.Editor.SmartStepBorder" Color="#C76DC7" />
            <!-- Rider Dark's WHITESPACES and SOFT_WRAP_SIGN_COLOR. -->
            <SolidColorBrush x:Key="Passenger.Editor.Whitespace" Color="#686868" />
            <SolidColorBrush x:Key="Passenger.Editor.SoftWrapSign" Color="#787878" />

            <SolidColorBrush x:Key="Passenger.Syntax.Keyword" Color="#6C95EB" />
            <SolidColorBrush x:Key="Passenger.Syntax.ControlKeyword" Color="#6C95EB" />
            <SolidColorBrush x:Key="Passenger.Syntax.Comment" Color="#85C46C" />
            <SolidColorBrush x:Key="Passenger.Syntax.DocComment" Color="#85C46C" />
            <SolidColorBrush x:Key="Passenger.Syntax.String" Color="#C9A26D" />
            <SolidColorBrush x:Key="Passenger.Syntax.StringEscape" Color="#D688D4" />
            <SolidColorBrush x:Key="Passenger.Syntax.Number" Color="#ED94C0" />
            <SolidColorBrush x:Key="Passenger.Syntax.Preprocessor" Color="#8F98A3" />
            <SolidColorBrush x:Key="Passenger.Syntax.Class" Color="#C191FF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Interface" Color="#C191FF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Struct" Color="#E1BFFF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Enum" Color="#E1BFFF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Delegate" Color="#E1BFFF" />
            <SolidColorBrush x:Key="Passenger.Syntax.TypeParameter" Color="#C191FF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Method" Color="#39CC9B" />
            <SolidColorBrush x:Key="Passenger.Syntax.Property" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.Event" Color="#ED94C0" />
            <SolidColorBrush x:Key="Passenger.Syntax.Field" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.Constant" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.EnumMember" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.Excluded" Color="#6F737A" />
            <SolidColorBrush x:Key="Passenger.Syntax.ErrorOutput" Color="#FF6B68" />
            <SolidColorBrush x:Key="Passenger.Syntax.UserInput" Color="#6AAB73" />
            <SolidColorBrush x:Key="Passenger.Syntax.Link" Color="#6C95EB" />
            <SolidColorBrush x:Key="Passenger.Editor.LinkUnderline" Color="#406AC2" />
            <!-- The edge of a card the editor draws over its code: a folded region's preview. -->
            <SolidColorBrush x:Key="Passenger.Editor.PopupBorder" Color="#43454A" />
            <SolidColorBrush x:Key="Passenger.Syntax.Brace1" Color="#E8BA36" />
            <SolidColorBrush x:Key="Passenger.Syntax.Brace2" Color="#D670D6" />
            <SolidColorBrush x:Key="Passenger.Syntax.Brace3" Color="#3D9EF5" />
            <!-- The files beside the C#, as Rider Dark colours them: XML_TAG, XML_ATTRIBUTE_NAME and _VALUE,
                 XML_ENTITY_REFERENCE, JSON.PROPERTY_KEY, YAML_SCALAR_KEY, MARKDOWN_HEADER_LEVEL_1 (the constant's
                 colour, bold), MARKDOWN_CODE_SPAN, MARKDOWN_BLOCK_QUOTE and MARKDOWN_LINK_DESTINATION. Markdown's bold
                 and italic text keep the text's colour. -->
            <SolidColorBrush x:Key="Passenger.Syntax.Tag" Color="#C191FF" />
            <SolidColorBrush x:Key="Passenger.Syntax.AttributeName" Color="#85C46C" />
            <SolidColorBrush x:Key="Passenger.Syntax.AttributeValue" Color="#C9A26D" />
            <SolidColorBrush x:Key="Passenger.Syntax.Entity" Color="#FFD49E" />
            <SolidColorBrush x:Key="Passenger.Syntax.JsonKey" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.YamlKey" Color="#C191FF" />
            <SolidColorBrush x:Key="Passenger.Syntax.Heading" Color="#66C3CC" />
            <SolidColorBrush x:Key="Passenger.Syntax.Code" Color="#85C46C" />
            <SolidColorBrush x:Key="Passenger.Syntax.Quote" Color="#C9A26D" />
            <SolidColorBrush x:Key="Passenger.Syntax.LinkDestination" Color="#39CC9B" />
        </ResourceDictionary>
