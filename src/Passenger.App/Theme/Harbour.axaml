<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Harbour, Passenger's second theme (Settings, Appearance): warm and quiet, the app icon's teal on linen by day and a
         warm charcoal by night, its amber for what wants a glance. Every token of Tokens.axaml again, in Harbour's
         colours, laid over Passenger's when chosen (Themes); the shapes it draws its own way: rounder, the open editor
         tab a card in the editor's colour joined to it, round badges and chips, a popup with no crown. -->
    <CornerRadius x:Key="Passenger.ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="Passenger.ToolRadius">8</CornerRadius>
    <CornerRadius x:Key="Passenger.PopupRadius">12</CornerRadius>
    <CornerRadius x:Key="Passenger.CardRadius">14</CornerRadius>
    <CornerRadius x:Key="Passenger.BadgeRadius">99</CornerRadius>
    <CornerRadius x:Key="Passenger.ChipRadius">99</CornerRadius>
    <x:Double x:Key="Passenger.TabStripHeight">40</x:Double>
    <Thickness x:Key="Passenger.TabMargin">1,6,1,0</Thickness>
    <Thickness x:Key="Passenger.TabPadding">14,0,8,0</Thickness>
    <CornerRadius x:Key="Passenger.TabRadius">10,10,0,0</CornerRadius>
    <BoxShadows x:Key="Passenger.TabShadow">0 0 0 0 #00000000</BoxShadows>
    <Thickness x:Key="Passenger.PopupEdge">1</Thickness>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- The desk round the edges, the tool windows a step lighter, the editor the page between. -->
            <SolidColorBrush x:Key="Passenger.Frame" Color="#151311" />
            <SolidColorBrush x:Key="Passenger.Panel" Color="#221F1B" />
            <SolidColorBrush x:Key="Passenger.Field" Color="#171512" />
            <SolidColorBrush x:Key="Passenger.FieldBorder" Color="#3D3730" />
            <SolidColorBrush x:Key="Passenger.List" Color="#1B1916" />
            <SolidColorBrush x:Key="Passenger.Button" Color="#2A2622" />
            <SolidColorBrush x:Key="Passenger.Popup" Color="#27231F" />
            <SolidColorBrush x:Key="Passenger.PopupBorder" Color="#3A342D" />
            <BoxShadows x:Key="Passenger.PopupShadow">0 8 28 0 #8C000000</BoxShadows>
            <SolidColorBrush x:Key="Passenger.Popup.Edge" Color="#3A342D" />
            <SolidColorBrush x:Key="Passenger.Banner" Color="#24302C" />
            <SolidColorBrush x:Key="Passenger.DropZone" Color="#2CB5A3" Opacity="0.2" />

            <SolidColorBrush x:Key="Passenger.Divider" Color="#151311" />
            <SolidColorBrush x:Key="Passenger.Separator" Color="#302B26" />
            <SolidColorBrush x:Key="Passenger.StripeSeparator" Color="#3D3730" />
            <SolidColorBrush x:Key="Passenger.WindowEdge" Color="#3A342D" />

            <SolidColorBrush x:Key="Passenger.Text" Color="#EDE6DB" />
            <SolidColorBrush x:Key="Passenger.TextMuted" Color="#ADA497" />
            <SolidColorBrush x:Key="Passenger.TextDisabled" Color="#655D54" />
            <SolidColorBrush x:Key="Passenger.DisabledBorder" Color="#302B26" />
            <SolidColorBrush x:Key="Passenger.Icon" Color="#C8BFB1" />
            <SolidColorBrush x:Key="Passenger.Link" Color="#5ED3C2" />
            <SolidColorBrush x:Key="Passenger.LinkHover" Color="#8BE3D6" />
            <SolidColorBrush x:Key="Passenger.AccentText" Color="#0C1A18" />
            <SolidColorBrush x:Key="Passenger.BadgeText" Color="#171512" />
            <SolidColorBrush x:Key="Passenger.Error" Color="#F2808A" />
            <SolidColorBrush x:Key="Passenger.Warning" Color="#F0B654" />
            <SolidColorBrush x:Key="Passenger.TextSelection" Color="#2E4A45" />

            <SolidColorBrush x:Key="Passenger.Hover" Color="#12FFF0DC" />
            <SolidColorBrush x:Key="Passenger.Selected" Color="#1FFFF0DC" />
            <SolidColorBrush x:Key="Passenger.RowSelected" Color="#1E3D39" />
            <SolidColorBrush x:Key="Passenger.Accent" Color="#2CB5A3" />
            <SolidColorBrush x:Key="Passenger.AccentHover" Color="#3CC7B4" />
            <SolidColorBrush x:Key="Passenger.Focus" Color="#3CC7B4" />
            <SolidColorBrush x:Key="Passenger.CheckBorder" Color="#7A7166" />
            <SolidColorBrush x:Key="Passenger.ScrollThumb" Color="#59808080" />
            <SolidColorBrush x:Key="Passenger.ScrollThumbHover" Color="#8C808080" />
            <SolidColorBrush x:Key="Passenger.ScrollTrackHover" Color="#1A808080" />
            <!-- A menu's chosen item on a soft teal, its words and keys as they were. -->
            <SolidColorBrush x:Key="Passenger.Menu.Selected" Color="#1E3D39" />
            <SolidColorBrush x:Key="Passenger.Menu.SelectedText" Color="#EDE6DB" />
            <SolidColorBrush x:Key="Passenger.Menu.SelectedKeys" Color="#ADA497" />

            <!-- The title bar is the desk, its words and icons the window's own. -->
            <SolidColorBrush x:Key="Passenger.TitleBar" Color="#151311" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Text" Color="#EDE6DB" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Icon" Color="#C8BFB1" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Hover" Color="#2D2925" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Pressed" Color="#37322C" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Rule" Color="#3D3730" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Run" Color="#5CCB8F" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Stop" Color="#F2808A" />
            <SolidColorBrush x:Key="Passenger.TitleBar.HotReload" Color="#F2A266" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Focus" Color="#3CC7B4" />
            <SolidColorBrush x:Key="Passenger.TitleBar.Badge" Color="#2CB5A3" />
            <SolidColorBrush x:Key="Passenger.TitleBar.BadgeText" Color="#0C1A18" />
            <SolidColorBrush x:Key="Passenger.WindowButton.Hover" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Passenger.WindowButton.Pressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="Passenger.WindowButton.CloseHover" Color="#E81123" />
