            <SolidColorBrush x:Key="Passenger.Editor.Caret" Color="#4FCDBA" />
            <SolidColorBrush x:Key="Passenger.Editor.SearchMatch" Color="#3D3320" />
            <SolidColorBrush x:Key="Passenger.Editor.SearchCurrent" Color="#8A6A22" />
            <SolidColorBrush x:Key="Passenger.Editor.Error" Color="#F2747E" />
            <SolidColorBrush x:Key="Passenger.Editor.Warning" Color="#F0B654" />
            <SolidColorBrush x:Key="Passenger.Editor.Info" Color="#9A9184" />
            <SolidColorBrush x:Key="Passenger.Editor.Breakpoint" Color="#E8606B" />
            <SolidColorBrush x:Key="Passenger.Editor.BreakpointLine" Color="#33201F" />
            <SolidColorBrush x:Key="Passenger.Editor.BreakpointMuted" Color="#C8BFB1" />
            <SolidColorBrush x:Key="Passenger.Editor.Tracepoint" Color="#F0B654" />
