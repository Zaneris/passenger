            <SolidColorBrush x:Key="Passenger.Stripe.Selected" Color="#1E3D39" />
            <SolidColorBrush x:Key="Passenger.Stripe.SelectedIcon" Color="#6EDCCB" />
            <!-- The open editor tab in the editor's own colour, a card joined to its page. -->
            <SolidColorBrush x:Key="Passenger.Tab.Active" Color="#1B1916" />
            <SolidColorBrush x:Key="Passenger.Tab.ActiveText" Color="#EDE6DB" />
            <SolidColorBrush x:Key="Passenger.Modified" Color="#FFB547" />

            <SolidColorBrush x:Key="Passenger.Welcome.Tile" Color="#24201C" />
            <SolidColorBrush x:Key="Passenger.Welcome.TileBorder" Color="#24201C" />
            <BoxShadows x:Key="Passenger.Welcome.TileShadow">0 2 10 0 #59000000</BoxShadows>
            <SolidColorBrush x:Key="Passenger.Welcome.Chip" Color="#1E3D39" />
            <SolidColorBrush x:Key="Passenger.Welcome.ChipIcon" Color="#6EDCCB" />
            <SolidColorBrush x:Key="Passenger.Welcome.Badge" Color="#2CB5A3" />

            <SolidColorBrush x:Key="Passenger.Run" Color="#5CCB8F" />
            <SolidColorBrush x:Key="Passenger.HotReload" Color="#F2A266" />
            <SolidColorBrush x:Key="Passenger.Test.Passed" Color="#5CCB8F" />
            <SolidColorBrush x:Key="Passenger.Test.Failed" Color="#F2747E" />
