            <SolidColorBrush x:Key="Passenger.Editor.InlineValue" Color="#A89F92" />
            <SolidColorBrush x:Key="Passenger.Editor.InlayHint" Color="#A89F92" />
            <SolidColorBrush x:Key="Passenger.Editor.InlayHintBack" Color="#27231F" />
            <SolidColorBrush x:Key="Passenger.Editor.UsageRead" Color="#25302C" />
