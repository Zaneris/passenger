            <SolidColorBrush x:Key="Passenger.FileIcon.Maroon" Color="#D56D64" />
            <SolidColorBrush x:Key="Passenger.FileIcon.Grey" Color="#B9B1A4" />

            <SolidColorBrush x:Key="Passenger.Editor.Background" Color="#1B1916" />
            <SolidColorBrush x:Key="Passenger.Editor.Gutter" Color="#1B1916" />
            <SolidColorBrush x:Key="Passenger.Editor.PopupBorder" Color="#3A342D" />

            <!-- Harbour Night, the editor's own scheme: keywords in teal, types in gold, methods a soft sky blue, strings
                 sage, numbers terracotta, members mauve, comments warm grey in italics. -->
