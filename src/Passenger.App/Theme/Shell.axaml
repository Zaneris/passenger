<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The shell's controls over the Fluent theme. Fluent paints a button's hover and press on its
         content presenter, so each state is restyled there. A later style wins over an earlier one, so the base
         styles come first and a class's style after them says only how it differs. -->

    <Styles.Resources>
        <!-- Rider's new UI rounds a button, a text field and a combo box alike (Button.arc and Component.arc 8, a 4 px
             radius), a toolbar's buttons and tabs more, and a popup's frame most. -->
        <CornerRadius x:Key="Passenger.ControlRadius">4</CornerRadius>
        <CornerRadius x:Key="Passenger.ToolRadius">6</CornerRadius>
        <CornerRadius x:Key="Passenger.PopupRadius">8</CornerRadius>
        <!-- Fluent's controls Passenger leaves as they are (check boxes, number boxes, menus) read Fluent's radii. -->
        <StaticResource x:Key="ControlCornerRadius" ResourceKey="Passenger.ControlRadius" />
        <StaticResource x:Key="OverlayCornerRadius" ResourceKey="Passenger.PopupRadius" />
        <!-- A button, a field and a drop-down are one height, Rider's 28, so a row of them shares its edges. -->
        <x:Double x:Key="Passenger.ControlHeight">28</x:Double>
        <!-- An overlay keeps a generous pointer target around Rider's thin, arrowless thumb. -->
        <x:Double x:Key="Passenger.ScrollBarWidth">12</x:Double>
        <x:Double x:Key="Passenger.ScrollThumbWidth">6</x:Double>
        <!-- Fluent's template applies these transforms directly; keeping its panning scale would shrink a six-pixel
             thumb to less than one pixel even though the control's measured width is right. -->
        <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">none</TransformOperations>
        <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">none</TransformOperations>
        <!-- A check box's row as tall as a field's, so a page's rows are evenly spaced (Fluent's is 32, its box placed in
             a row of this height). -->
        <StaticResource x:Key="CheckBoxMinHeight" ResourceKey="Passenger.ControlHeight" />
        <!-- A submenu overlaps its item's menu as Fluent's does, its items being inset (MenuItem's margin below). -->
        <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">0</x:Double>
    </Styles.Resources>

    <!-- All scrollable surfaces use the same overlay rail. Fluent supplies wheel, track and drag behavior; only its
         arrows and opaque track go, so a bar never takes width away from the content or looks like a separate panel. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="MinWidth" Value="{DynamicResource Passenger.ScrollBarWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ScrollBarWidth}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton, ScrollBar /template/ RepeatButton#PART_LineDownButton, ScrollBar /template/ Rectangle#TrackRect, ScrollViewer /template/ Panel#PART_ScrollBarsSeparator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollBar /template/ Grid#Root">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Passenger.TextMuted}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="Width" Value="{DynamicResource Passenger.ScrollThumbWidth}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="Height" Value="{DynamicResource Passenger.ScrollThumbWidth}" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb, ScrollBar /template/ Thumb:pressed">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- A button: its content centred (Fluent leaves it at the left of a button wider than it, as a dialog's footer
         makes each), Rider's height and side padding, the shared radius. One that reads as text (crumb, link,
         statusItem) says otherwise in its own style, as the small square ones (tool, tabClose) say their size. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Passenger.Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.DisabledBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.DisabledBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.DisabledText}" />
    </Style>
    <!-- A menu's chosen item on a rounded band inset from the menu's rounded frame, as Rider's are, where Fluent's runs
         square to the frame's edges. -->
    <Style Selector="MenuItem">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
    </Style>
    <!-- A long option wraps within its page so its label stays readable. -->
    <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="RadioButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Empty panes keep their title and next step readable inside the space left by tool windows. -->
    <Style Selector="StackPanel.emptyState">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24,0" />
    </Style>
    <Style Selector="StackPanel.emptyState > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.emptyHint">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>

    <!-- A new dialog inherits the chrome; page wrappers share it instead of introducing an editor-coloured island. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Passenger.Chrome}" />
    </Style>
    <Style Selector="Border.dialogPage">
        <Setter Property="Background" Value="{DynamicResource Passenger.Chrome}" />
    </Style>

    <!-- A dialog's buttons at its foot (DialogFooter), each as wide as the others at the least. -->
    <Style Selector="StackPanel.footer">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.footer > Button">
        <Setter Property="MinWidth" Value="80" />
    </Style>
    <!-- The bar a dialog's footer stands in under its page, on the chrome as Settings' is, a divider above it. -->
    <Style Selector="Border.footerBar">
        <Setter Property="Background" Value="{DynamicResource Passenger.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <!-- A list, table or text in a page, framed as a field is: a frame in the divider's colour vanishes on the editor's
         background in dark. -->
    <Style Selector="Border.framed">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
    </Style>
    <!-- Selected text as the editor shows it, readable in both themes: Fluent's is the system's saturated blue, under
         black text in light. -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Passenger.Editor.Selection}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- A drop-down framed as a field and as tall, its text inset as a field's (Fluent's is taller and its frame
         brighter). -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
    </Style>
    <!-- A disabled drop-down or field stands on the page's own ground with its frame and dimmed text, as Rider's does:
         Fluent's solid grey slab read as a button, in light most of all. -->
    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
    </Style>
    <Style Selector="TextBox.search:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
    </Style>
    <!-- A number box likewise, its own height beside something taller; its text box no taller than the box. -->
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="10,4,6,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- The number's text box is part of the one box: no frame or ground of its own when focused, under the pointer or
         disabled (Fluent drew a second, brighter frame round the number alone), the box's frame taking the accent while
         it has the keys; disabled, its buttons stand on the page's ground as the field does. -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="NumericUpDown:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Accent}" />
    </Style>
    <!-- An unticked box's edge in its own token: Fluent's is far brighter than the fields beside it. -->
    <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.CheckBorder}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.paneTitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- An action whose shortcuts the person changed, on Settings' Keymap page, in the colour Rider's keymap gives one. -->
    <Style Selector="TextBlock.shortcutsChanged">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Modified}" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Icon}" />
    </Style>
    <Style Selector="PathIcon.chevron">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- A test's mark in the Unit Tests window, as Rider's: grey ring not run, blue dot running, green tick passed, red
         cross failed, grey dash skipped. -->
    <Style Selector="PathIcon.testState">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="3,0,9,0" />
        <Setter Property="Data" Value="{DynamicResource Icon.TestNotRun}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Test.NotRun}" />
    </Style>
    <Style Selector="PathIcon.testState.running">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="3.5,0,9.5,0" />
        <Setter Property="Data" Value="{DynamicResource Icon.TestRunning}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Test.Running}" />
    </Style>
    <Style Selector="PathIcon.testState.passed">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="2,0,8,0" />
        <Setter Property="Data" Value="{DynamicResource Icon.TestPassed}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Test.Passed}" />
    </Style>
    <Style Selector="PathIcon.testState.failed">
        <Setter Property="Data" Value="{DynamicResource Icon.TestFailed}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Test.Failed}" />
    </Style>
    <Style Selector="PathIcon.testState.skipped">
        <Setter Property="Data" Value="{DynamicResource Icon.TestSkipped}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Test.Skipped}" />
    </Style>

    <!-- An outcome filter on the Unit Tests window's toolbar, as Rider's: the outcome's mark and how many tests have it,
         the ones chosen on a raised band. -->
    <Style Selector="ToggleButton.outcome">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ToggleButton.outcome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ToggleButton.outcome:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ToggleButton.outcome:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ToggleButton.outcome PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- A frame of a test's result in the Unit Tests window: a thumbnail of the window as the test failed, which opens it at
         its size. -->
    <Style Selector="Button.frame">
        <Setter Property="Padding" Value="5" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Divider}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.frame:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Divider}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="Button.frame:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Divider}" />
    </Style>
    <Style Selector="Button.frame:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Divider}" />
    </Style>

    <!-- A stripe button: an icon down the window's edge that opens a tool window. -->
    <Style Selector="ToggleButton.stripe">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.stripe:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="ToggleButton.stripe:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>
    <Style Selector="ToggleButton.stripe:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>

    <!-- A toolbar widget (a name and a chevron) or a toolbar icon button. -->
    <Style Selector="Button.widget">
        <Setter Property="Height" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.widget:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="Button.widget:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>
    <!-- The window's buttons at the merged title bar's right, as Rider draws them on Windows: the bar's height, square
         corners, thin glyphs, and red under Close. -->
    <Style Selector="Button.windowButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.windowButton Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource Passenger.Icon}" />
    </Style>
    <Style Selector="Button.windowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.WindowButton.Hover}" />
    </Style>
    <Style Selector="Button.windowButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.WindowButton.Pressed}" />
    </Style>
    <Style Selector="Button.windowButton.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.WindowButton.CloseHover}" />
    </Style>
    <Style Selector="Button.windowButton.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.WindowButton.ClosePressed}" />
    </Style>
    <Style Selector="Button.windowButton.close:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource Passenger.WindowButton.CloseGlyph}" />
    </Style>
    <!-- A toolbar toggle (Mute Breakpoints): a tool button that stays pressed while it is on. -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>
    <!-- An action that cannot run now keeps its place, dimmed, as Rider's toolbars do. -->
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool:disabled PathIcon">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- A splitter that draws nothing: a hairline Border beside it is what shows, and the splitter
         overhangs its 1 px column so there is something to grab. -->
    <Style Selector="GridSplitter.hairline">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="7" />
        <Setter Property="Margin" Value="-3,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.hairline:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A status bar item that does something on a click, framed only under the pointer. -->
    <Style Selector="Button.statusItem">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.statusItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.small">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- A tree drawn as a flat list (the Explorer): compact rows, selection as a filled band. -->
    <Style Selector="ListBox.tree">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="24" />
        <!-- A row's words midway down its band, where Fluent would leave a line shorter than the row at its top. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.RowSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.RowSelected}" />
    </Style>
    <!-- Settings' pages under its search field: the band as wide as the field, a page's name where the field's text starts. -->
    <Style Selector="ListBox.pages">
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="ListBox.pages ListBoxItem">
        <Setter Property="Padding" Value="11,0" />
    </Style>
    <!-- A framed list's chosen row clear of the frame's top and foot. -->
    <Style Selector="Border.framed > ListBox.tree">
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- An editor tab: the active one underlined in the accent with its close button shown; an unsaved dot has its own
         place, so the active file still says it is modified while its close button is shown. -->
    <Style Selector="Border.tab">
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="Border.tab.active">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Accent}" />
    </Style>
    <Style Selector="Border.tab TextBlock.tabName">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>
    <Style Selector="Border.tab.active TextBlock.tabName">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- A split the person is not working in marks its file quieter, so the strong mark is where the keys go. -->
    <Style Selector="Border.tab.active.elsewhere">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>
    <Style Selector="Ellipse.modified">
        <Setter Property="Fill" Value="{DynamicResource Passenger.Modified}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabClose">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.tab:pointerover Button.tabClose">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.tab.active Button.tabClose">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- A tool window's tab that closes (a search's, a history's): its × on the open one and the one under the pointer. -->
    <Style Selector="ToggleButton.panelTab:pointerover Button.tabClose">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.panelTab:checked Button.tabClose">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tabClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>
    <!-- A pinned tab's pin, always shown, which unpins it. -->
    <Style Selector="Button.tabPin">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tabPin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
    </Style>

    <!-- A search field (the find bar, Go to File): flat, the chrome's own colour, an accent edge when
         focused, and room at its right for toggles drawn inside it. -->
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
        <!-- Fluent's padding would make it a pixel taller than the buttons and drop-downs beside it. -->
        <Setter Property="Padding" Value="10,4,6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Its own height in a row beside something taller (a check box), not stretched to that one's. -->
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- A field of several lines starts its text at its top, not halfway down. -->
    <Style Selector="TextBox.search[AcceptsReturn=True]">
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Passenger.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.FieldBorder}" />
    </Style>
    <!-- Fluent turns a focused field black (white in light); Rider's keeps its own ground and gains the accent edge.
         After the field's own edge, which would otherwise win and leave the focused field's edge grey. -->
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Passenger.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Accent}" />
    </Style>
    <Style Selector="TextBox.search:focus">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- A table's editable cell (Change Signature's parameters): flat on the row's own colour, an accent line under it
         while it has the keys. -->
    <Style Selector="TextBox.cell">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Accent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBox.cell:focus">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- A table's drop-down cell (a parameter's modifier): flat as the text cells beside it until the pointer is over it. -->
    <Style Selector="ComboBox.cell">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.cell:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="ToggleButton.option">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Icon}" />
    </Style>
    <Style Selector="ToggleButton.option PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="ToggleButton.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
    </Style>
    <Style Selector="ToggleButton.option:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.AccentText}" />
    </Style>
    <Style Selector="ToggleButton.option:checked PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.AccentText}" />
    </Style>

    <!-- A drop-down as tall as a search field beside it (Find in Files' scope and mask); an editable one's text centred
         in it, where Fluent's taller text box would put it at the top. -->
    <Style Selector="ComboBox.compact">
        <Setter Property="MinHeight" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="Height" Value="{DynamicResource Passenger.ControlHeight}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.compact /template/ TextBox#PART_EditableTextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- A disabled editable drop-down's text has no ground of its own, where Fluent's disabled text box drew a second box
         inside the drop-down's. Named by its state: a style without it lost to Fluent's disabled one. -->
    <Style Selector="TextBox#PART_EditableTextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A popup over the window (Go to File, Go to Line): the chrome's colour, a soft shadow. -->
    <Style Selector="Border.popup">
        <Setter Property="Background" Value="{DynamicResource Passenger.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Selected}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.PopupRadius}" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #70000000" />
    </Style>

    <Style Selector="GridSplitter.hairlineRows">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,-3" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.hairlineRows:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A bottom tool window's tab: plain text, the open one on a raised band. -->
    <Style Selector="ScrollViewer.toolTabs">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ToggleButton.panelTab">
        <!-- A keyboard focus ring is decoration: it must not cover an overlay scrollbar's pointer target. -->
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border IsHitTestVisible="False" BorderThickness="1"
                        BorderBrush="{DynamicResource Passenger.Accent}"
                        CornerRadius="{DynamicResource Passenger.ToolRadius}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ToolRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>
    <Style Selector="ToggleButton.panelTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>
    <!-- A tab with nothing behind it yet is dimmed, not filled; before :checked, so the open one keeps its band. -->
    <Style Selector="ToggleButton.panelTab:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.panelTab:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>

    <!-- The one emphasised action on a page: only its colours differ, so it is the size and shape of the buttons beside
         it. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Passenger.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.AccentText}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.AccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.AccentText}" />
    </Style>
    <!-- Disabled actions have Rider's quiet outline and muted words. This follows the primary states so a default
         that becomes unavailable under the pointer cannot retain its accent or look like the enabled Cancel. -->
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.DisabledBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Passenger.DisabledBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.DisabledText}" />
    </Style>

    <!-- The status bar's path: a part is a quiet button, underlined under the pointer. -->
    <Style Selector="Button.crumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.TextMuted}" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Passenger.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Text}" />
    </Style>

    <!-- A link in running text (About's), as Rider draws one: its words in the link colour, nothing behind them. -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Link}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.LinkHover}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Passenger.LinkHover}" />
    </Style>

    <!-- A file's name in the colour of how version control says it changed, as Rider's Project view has it. -->
    <Style Selector="TextBlock.vcsModified">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Vcs.File.Modified}" />
    </Style>
    <Style Selector="TextBlock.vcsAdded">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Vcs.File.Added}" />
    </Style>
    <Style Selector="TextBlock.vcsUnversioned">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Vcs.File.Unversioned}" />
    </Style>
    <Style Selector="TextBlock.vcsConflicted">
        <Setter Property="Foreground" Value="{DynamicResource Passenger.Vcs.File.Conflicted}" />
    </Style>
</Styles>
