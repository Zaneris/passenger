    <x:String x:Key="RadioButtonCheckGlyphFillDisabled">Passenger.AccentText</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedFill">Passenger.Accent</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedFillPointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedFillPressed">Passenger.Accent</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedFillDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedStroke">Passenger.Accent</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedStrokePressed">Passenger.Accent</x:String>
    <x:String x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled">Passenger.TextDisabled</x:String>
