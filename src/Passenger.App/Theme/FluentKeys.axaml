    <x:String x:Key="ComboBoxItemBackgroundSelected">Passenger.RowSelected</x:String>
    <x:String x:Key="ComboBoxItemBackgroundSelectedPointerOver">Passenger.RowSelected</x:String>
    <x:String x:Key="ComboBoxItemBackgroundSelectedPressed">Passenger.RowSelected</x:String>

    <!-- Every ContextMenu and MenuItem: the popup's ground and edge, a chosen item in the menu's own colours (solid in the
         accent with white words in Passenger's theme), keys muted, a submenu's chevron an icon. -->
    <x:String x:Key="MenuFlyoutPresenterBackground">Passenger.Popup</x:String>
    <x:String x:Key="MenuFlyoutPresenterBorderBrush">Passenger.PopupBorder</x:String>
    <x:String x:Key="MenuFlyoutItemForeground">Passenger.Text</x:String>
    <x:String x:Key="MenuFlyoutItemForegroundPointerOver">Passenger.Menu.SelectedText</x:String>
    <x:String x:Key="MenuFlyoutItemForegroundPressed">Passenger.Menu.SelectedText</x:String>
    <x:String x:Key="MenuFlyoutItemForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="MenuFlyoutItemBackgroundPointerOver">Passenger.Menu.Selected</x:String>
    <x:String x:Key="MenuFlyoutItemBackgroundPressed">Passenger.Menu.Selected</x:String>
    <x:String x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground">Passenger.TextMuted</x:String>
    <x:String x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver">Passenger.Menu.SelectedKeys</x:String>
    <x:String x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed">Passenger.Menu.SelectedKeys</x:String>
    <x:String x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="MenuFlyoutSubItemChevron">Passenger.Icon</x:String>
    <x:String x:Key="MenuFlyoutSubItemChevronPointerOver">Passenger.Menu.SelectedText</x:String>
    <x:String x:Key="MenuFlyoutSubItemChevronPressed">Passenger.Menu.SelectedText</x:String>
    <x:String x:Key="MenuFlyoutSubItemChevronSubMenuOpened">Passenger.Menu.SelectedText</x:String>
    <x:String x:Key="MenuFlyoutSubItemChevronDisabled">Passenger.TextDisabled</x:String>

    <!-- A tooltip on the popup's ground and edge in the window's words. -->
    <x:String x:Key="ToolTipBackground">Passenger.Popup</x:String>
    <x:String x:Key="ToolTipBorderBrush">Passenger.PopupBorder</x:String>
    <x:String x:Key="ToolTipForeground">Passenger.Text</x:String>

    <!-- The corner where a scroll view's two bars meet, the track's own wash (ControlThemes.axaml's bars). -->
    <x:String x:Key="ScrollViewerScrollBarsSeparatorBackground">Passenger.ScrollTrackHover</x:String>

    <!-- A window's drawn title bar and its buttons where the system draws none: the frame's ground and the window's icons. -->
    <x:String x:Key="TitleBarBackgroundBrush">Passenger.Frame</x:String>
    <x:String x:Key="CaptionButtonBackground">Passenger.Frame</x:String>
    <x:String x:Key="CaptionButtonBorderBrush">Passenger.WindowEdge</x:String>
    <x:String x:Key="CaptionButtonForeground">Passenger.Icon</x:String>

    <!-- Fluent's system brushes, which its templates for lists, progress bars, number boxes, separators and windows read:
         by what each is in Fluent's palette, Alt being the ground and Base the ink. Grounds: the accent, the field and the
         page, a plain button's, a popup's (Chrome), the hover and chosen washes (List). -->
    <x:String x:Key="SystemControlBackgroundAccentBrush">Passenger.Accent</x:String>
    <x:String x:Key="SystemControlBackgroundAltHighBrush">Passenger.Field</x:String>
    <x:String x:Key="SystemControlBackgroundAltMediumHighBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlBackgroundAltMediumBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlBackgroundAltMediumLowBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlBackgroundBaseHighBrush">Passenger.Text</x:String>
    <x:String x:Key="SystemControlBackgroundBaseMediumHighBrush">Passenger.CheckBorder</x:String>
    <x:String x:Key="SystemControlBackgroundBaseMediumBrush">Passenger.CheckBorder</x:String>
    <x:String x:Key="SystemControlBackgroundBaseMediumLowBrush">Passenger.Selected</x:String>
    <x:String x:Key="SystemControlBackgroundBaseLowBrush">Passenger.Button</x:String>
    <x:String x:Key="SystemControlBackgroundChromeBlackHighBrush">Passenger.Frame</x:String>
    <x:String x:Key="SystemControlBackgroundChromeBlackMediumBrush">Passenger.Frame</x:String>
    <x:String x:Key="SystemControlBackgroundChromeBlackMediumLowBrush">Passenger.Frame</x:String>
    <x:String x:Key="SystemControlBackgroundChromeBlackLowBrush">Passenger.Frame</x:String>
    <x:String x:Key="SystemControlBackgroundChromeMediumBrush">Passenger.Popup</x:String>
    <x:String x:Key="SystemControlBackgroundChromeMediumLowBrush">Passenger.Popup</x:String>
    <x:String x:Key="SystemControlBackgroundChromeWhiteBrush">Passenger.AccentText</x:String>
    <x:String x:Key="SystemControlBackgroundChromeWhiteRevealBorderBrush">Passenger.AccentText</x:String>
    <x:String x:Key="SystemControlBackgroundListLowBrush">Passenger.Hover</x:String>
    <x:String x:Key="SystemControlBackgroundListMediumBrush">Passenger.Selected</x:String>
    <x:String x:Key="SystemControlPageBackgroundAltHighBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlPageBackgroundAltMediumBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlPageBackgroundMediumAltMediumBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlPageBackgroundBaseLowBrush">Passenger.Selected</x:String>
    <x:String x:Key="SystemControlPageBackgroundBaseMediumBrush">Passenger.CheckBorder</x:String>
    <x:String x:Key="SystemControlPageBackgroundChromeLowBrush">Passenger.Panel</x:String>
    <x:String x:Key="SystemControlPageBackgroundChromeMediumLowBrush">Passenger.Popup</x:String>
    <x:String x:Key="SystemControlPageBackgroundListLowBrush">Passenger.Hover</x:String>
    <x:String x:Key="SystemControlTransientBackgroundBrush">Passenger.Popup</x:String>
    <x:String x:Key="SystemControlTransientBorderBrush">Passenger.PopupBorder</x:String>
    <x:String x:Key="SystemRegionBrush">Passenger.Panel</x:String>
    <!-- Words and marks: the window's words, quieter and dimmed (Base), the ground's own colour for a mark on the ink's
         (Alt), the accent's words (Chrome white), an error's, a link's. -->
    <x:String x:Key="SystemControlForegroundAccentBrush">Passenger.Accent</x:String>
    <x:String x:Key="SystemControlForegroundAltHighBrush">Passenger.Field</x:String>
    <x:String x:Key="SystemControlForegroundAltMediumHighBrush">Passenger.Field</x:String>
    <x:String x:Key="SystemControlForegroundBaseHighBrush">Passenger.Text</x:String>
    <x:String x:Key="SystemControlForegroundBaseMediumHighBrush">Passenger.Text</x:String>
