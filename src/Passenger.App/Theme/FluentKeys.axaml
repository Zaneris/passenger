    <x:String x:Key="RadioButtonOuterEllipseStrokePressed">Passenger.CheckBorder</x:String>
    <x:String x:Key="RadioButtonOuterEllipseStrokeDisabled">Passenger.DisabledBorder</x:String>

    <!-- A text field on the field's ground whether or not it has the keys, framed as a field, the accent's edge while it
         has them; disabled, on the page's ground; its hint muted; its buttons (a clear button) icons. -->
    <x:String x:Key="TextControlBackground">Passenger.Field</x:String>
    <x:String x:Key="TextControlBackgroundPointerOver">Passenger.Field</x:String>
    <x:String x:Key="TextControlBackgroundFocused">Passenger.Field</x:String>
    <x:String x:Key="TextControlBackgroundDisabled">Passenger.Panel</x:String>
    <x:String x:Key="TextControlBorderBrush">Passenger.FieldBorder</x:String>
    <x:String x:Key="TextControlBorderBrushPointerOver">Passenger.FieldBorder</x:String>
    <x:String x:Key="TextControlBorderBrushFocused">Passenger.Accent</x:String>
    <x:String x:Key="TextControlBorderBrushDisabled">Passenger.DisabledBorder</x:String>
    <x:String x:Key="TextControlForeground">Passenger.Text</x:String>
    <x:String x:Key="TextControlForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="TextControlForegroundFocused">Passenger.Text</x:String>
    <x:String x:Key="TextControlForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="TextControlPlaceholderForeground">Passenger.TextMuted</x:String>
    <x:String x:Key="TextControlPlaceholderForegroundPointerOver">Passenger.TextMuted</x:String>
    <x:String x:Key="TextControlPlaceholderForegroundFocused">Passenger.TextMuted</x:String>
    <x:String x:Key="TextControlPlaceholderForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="TextControlSelectionHighlightColor">Passenger.TextSelection</x:String>
    <x:String x:Key="TextControlButtonBackgroundPressed">Passenger.Accent</x:String>
    <x:String x:Key="TextControlButtonForeground">Passenger.Icon</x:String>
    <x:String x:Key="TextControlButtonForegroundPointerOver">Passenger.Accent</x:String>
    <x:String x:Key="TextControlButtonForegroundPressed">Passenger.AccentText</x:String>

    <!-- A drop-down framed as a field and on its ground, its edge a field's accent while it has the keys; its list the
         popup's ground and edge in the window's words, the chosen row a list's, the one under the pointer washed. -->
    <x:String x:Key="ComboBoxBackground">Passenger.Field</x:String>
    <x:String x:Key="ComboBoxBackgroundPointerOver">Passenger.Field</x:String>
    <x:String x:Key="ComboBoxBackgroundPressed">Passenger.Field</x:String>
    <x:String x:Key="ComboBoxBackgroundUnfocused">Passenger.Field</x:String>
    <x:String x:Key="ComboBoxBackgroundDisabled">Passenger.Panel</x:String>
    <x:String x:Key="ComboBoxBackgroundBorderBrushUnfocused">Passenger.FieldBorder</x:String>
    <x:String x:Key="ComboBoxBackgroundBorderBrushFocused">Passenger.Accent</x:String>
    <x:String x:Key="ComboBoxBorderBrush">Passenger.FieldBorder</x:String>
    <x:String x:Key="ComboBoxBorderBrushPointerOver">Passenger.FieldBorder</x:String>
    <x:String x:Key="ComboBoxBorderBrushPressed">Passenger.FieldBorder</x:String>
    <x:String x:Key="ComboBoxBorderBrushDisabled">Passenger.FieldBorder</x:String>
    <x:String x:Key="ComboBoxForeground">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxForegroundFocused">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxForegroundFocusedPressed">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="ComboBoxPlaceHolderForeground">Passenger.TextMuted</x:String>
    <x:String x:Key="ComboBoxPlaceHolderForegroundFocusedPressed">Passenger.TextMuted</x:String>
    <x:String x:Key="ComboBoxDropDownGlyphForeground">Passenger.Icon</x:String>
    <x:String x:Key="ComboBoxDropDownGlyphForegroundFocused">Passenger.Icon</x:String>
    <x:String x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed">Passenger.Icon</x:String>
    <x:String x:Key="ComboBoxDropDownGlyphForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="ComboBoxDropDownBackground">Passenger.Popup</x:String>
    <x:String x:Key="ComboBoxDropDownBorderBrush">Passenger.PopupBorder</x:String>
    <x:String x:Key="ComboBoxItemForeground">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundPressed">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundSelected">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundSelectedPointerOver">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundSelectedPressed">Passenger.Text</x:String>
    <x:String x:Key="ComboBoxItemForegroundDisabled">Passenger.TextDisabled</x:String>
