<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent's own keys, each named once as the Passenger token it is in every theme (read by FluentKeys), so a theme
         supplies only tokens and cannot leave one of Fluent's greys showing. Each entry is a Fluent key and the token it
         reads. A key Fluent gives clear in both variants, and a control Passenger never shows, stay Fluent's;
         FluentKeysTests fails on any other key missing here. -->

    <!-- The corners of Fluent's controls Passenger leaves as they are (check boxes, number boxes, menus): the look's. -->
    <x:String x:Key="ControlCornerRadius">Passenger.ControlRadius</x:String>
    <x:String x:Key="OverlayCornerRadius">Passenger.PopupRadius</x:String>

    <!-- A button as Shell.axaml draws it in every state: its plain ground, its words, dimmed when it cannot be used. -->
    <x:String x:Key="ButtonBackground">Passenger.Button</x:String>
    <x:String x:Key="ButtonBackgroundPointerOver">Passenger.Button</x:String>
    <x:String x:Key="ButtonBackgroundPressed">Passenger.Button</x:String>
    <x:String x:Key="ButtonBackgroundDisabled">Passenger.Button</x:String>
    <x:String x:Key="ButtonForeground">Passenger.Text</x:String>
    <x:String x:Key="ButtonForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="ButtonForegroundPressed">Passenger.Text</x:String>
    <x:String x:Key="ButtonForegroundDisabled">Passenger.TextDisabled</x:String>

    <!-- A repeat button (a number box's arrows): a plain button's ground, washed under the pointer and pressed. -->
    <x:String x:Key="RepeatButtonBackground">Passenger.Button</x:String>
    <x:String x:Key="RepeatButtonBackgroundPointerOver">Passenger.Hover</x:String>
    <x:String x:Key="RepeatButtonBackgroundPressed">Passenger.Selected</x:String>
    <x:String x:Key="RepeatButtonBackgroundDisabled">Passenger.Button</x:String>
    <x:String x:Key="RepeatButtonForeground">Passenger.Text</x:String>
    <x:String x:Key="RepeatButtonForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="RepeatButtonForegroundPressed">Passenger.Text</x:String>
    <x:String x:Key="RepeatButtonForegroundDisabled">Passenger.TextDisabled</x:String>

    <!-- A toggle a class of Shell.axaml leaves a state of to Fluent: washed under the pointer and pressed, on the accent
         with the accent's words while on. -->
    <x:String x:Key="ToggleButtonBackground">Passenger.Button</x:String>
    <x:String x:Key="ToggleButtonBackgroundPointerOver">Passenger.Hover</x:String>
    <x:String x:Key="ToggleButtonBackgroundPressed">Passenger.Selected</x:String>
    <x:String x:Key="ToggleButtonBackgroundDisabled">Passenger.Button</x:String>
    <x:String x:Key="ToggleButtonBackgroundChecked">Passenger.Accent</x:String>
    <x:String x:Key="ToggleButtonBackgroundCheckedPointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="ToggleButtonBackgroundCheckedPressed">Passenger.Accent</x:String>
    <x:String x:Key="ToggleButtonBackgroundCheckedDisabled">Passenger.Button</x:String>
    <x:String x:Key="ToggleButtonBackgroundIndeterminate">Passenger.Button</x:String>
    <x:String x:Key="ToggleButtonBackgroundIndeterminatePointerOver">Passenger.Hover</x:String>
    <x:String x:Key="ToggleButtonBackgroundIndeterminatePressed">Passenger.Selected</x:String>
    <x:String x:Key="ToggleButtonBackgroundIndeterminateDisabled">Passenger.Button</x:String>
    <x:String x:Key="ToggleButtonBorderBrushIndeterminatePointerOver">Passenger.FieldBorder</x:String>
    <x:String x:Key="ToggleButtonForeground">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundPressed">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="ToggleButtonForegroundChecked">Passenger.AccentText</x:String>
    <x:String x:Key="ToggleButtonForegroundCheckedPointerOver">Passenger.AccentText</x:String>
    <x:String x:Key="ToggleButtonForegroundCheckedPressed">Passenger.AccentText</x:String>
    <x:String x:Key="ToggleButtonForegroundCheckedDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="ToggleButtonForegroundIndeterminate">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundIndeterminatePointerOver">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundIndeterminatePressed">Passenger.Text</x:String>
    <x:String x:Key="ToggleButtonForegroundIndeterminateDisabled">Passenger.TextDisabled</x:String>

    <!-- A check box: its box's edge its own token (Shell.axaml's), ticked on the accent with the accent's words for its
         tick, which a light accent (Harbour's) needs dark; its words the window's. -->
    <x:String x:Key="CheckBoxCheckBackgroundFillChecked">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillCheckedPressed">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillCheckedDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillIndeterminate">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundFillUncheckedPressed">Passenger.Selected</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeUnchecked">Passenger.CheckBorder</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver">Passenger.CheckBorder</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed">Passenger.CheckBorder</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled">Passenger.DisabledBorder</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeIndeterminate">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver">Passenger.AccentHover</x:String>
    <x:String x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed">Passenger.Accent</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundChecked">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundCheckedPressed">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundIndeterminate">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundUnchecked">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundUncheckedPressed">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxCheckGlyphForegroundUncheckedDisabled">Passenger.AccentText</x:String>
    <x:String x:Key="CheckBoxForegroundChecked">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundCheckedPointerOver">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundCheckedPressed">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundCheckedDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="CheckBoxForegroundIndeterminate">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundIndeterminatePointerOver">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundIndeterminatePressed">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundIndeterminateDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="CheckBoxForegroundUnchecked">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundUncheckedPointerOver">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundUncheckedPressed">Passenger.Text</x:String>
    <x:String x:Key="CheckBoxForegroundUncheckedDisabled">Passenger.TextDisabled</x:String>

    <!-- A radio button as a check box: its ring a box's edge, chosen on the accent with the accent's words for its dot. -->
    <x:String x:Key="RadioButtonForeground">Passenger.Text</x:String>
    <x:String x:Key="RadioButtonForegroundPointerOver">Passenger.Text</x:String>
    <x:String x:Key="RadioButtonForegroundPressed">Passenger.Text</x:String>
    <x:String x:Key="RadioButtonForegroundDisabled">Passenger.TextDisabled</x:String>
    <x:String x:Key="RadioButtonCheckGlyphFill">Passenger.AccentText</x:String>
