<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="using:Passenger.App">
    <!-- Passenger's own themes for the controls it draws whole, in place of Fluent's: in App.axaml's resources, which a
         control finds before the Fluent theme's. Shell.axaml restyles the rest. -->

    <!-- The ring round what has the keys: rounded as what it surrounds, just outside its edge, a check box's or a radio
         button's round the box alone (FocusRing). -->
    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <app:FocusRing Brush="{DynamicResource Passenger.Focus}" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>

    <!-- Every scrollbar: a thin rounded thumb over what scrolls, no arrows, no track until the pointer is over it, shown
         only while there is something to scroll (a ScrollViewer's Auto, the editor's own rule). A ScrollViewer lays what it
         shows under its upright bar (Fluent's AllowAutoHide, on by default), so that bar takes no room of its own; a
         sideways bar, and a text box's upright one, take their own while they show (Shell.axaml), so no row or line is
         ever under one. -->

    <!-- How broad a bar is, and its thumb at rest and under the pointer; the editor's bar is broader, as it carries the
         error stripe's marks. -->
    <x:Double x:Key="Passenger.ScrollBarSize">10</x:Double>
    <x:Double x:Key="Passenger.EditorScrollBarSize">14</x:Double>
    <x:Double x:Key="Passenger.ScrollThumbSize">6</x:Double>
    <x:Double x:Key="Passenger.ScrollThumbHoverSize">8</x:Double>
    <CornerRadius x:Key="Passenger.ScrollThumbRadius">4</CornerRadius>

    <ControlTheme x:Key="Passenger.ScrollThumbTheme" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Passenger.ScrollThumb}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Passenger.ScrollThumbRadius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource Passenger.ScrollThumbHover}" />
        </Style>
    </ControlTheme>

    <!-- The track either side of the thumb: a click there pages. -->
    <ControlTheme x:Key="Passenger.ScrollPageTheme" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource Passenger.ScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root" Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Passenger.ScrollPageTheme}" AutomationProperties.Name="Page up" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Passenger.ScrollPageTheme}" AutomationProperties.Name="Page down" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource Passenger.ScrollThumbTheme}"
                                   Width="{DynamicResource Passenger.ScrollThumbSize}"
                                   MinHeight="24"
                                   HorizontalAlignment="Center" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource Passenger.ScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root" Background="{TemplateBinding Background}">
                        <Track Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Passenger.ScrollPageTheme}" AutomationProperties.Name="Page left" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Passenger.ScrollPageTheme}" AutomationProperties.Name="Page right" />
                            </Track.IncreaseButton>
                            <Thumb Theme="{StaticResource Passenger.ScrollThumbTheme}"
                                   Height="{DynamicResource Passenger.ScrollThumbSize}"
                                   MinWidth="24"
                                   VerticalAlignment="Center" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- The editor's bar carries the error stripe, so it stays as broad with nothing to scroll. -->
        <Style Selector="^.stripe:vertical">
            <Setter Property="Width" Value="{DynamicResource Passenger.EditorScrollBarSize}" />
        </Style>

        <!-- Under the pointer the track shows and the thumb darkens and broadens. -->
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource Passenger.ScrollTrackHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource Passenger.ScrollThumbHover}" />
        </Style>
        <Style Selector="^:pointerover:vertical /template/ Thumb">
            <Setter Property="Width" Value="{DynamicResource Passenger.ScrollThumbHoverSize}" />
        </Style>
        <Style Selector="^:pointerover:horizontal /template/ Thumb">
            <Setter Property="Height" Value="{DynamicResource Passenger.ScrollThumbHoverSize}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
