<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:Passenger.Editor"
             x:Class="Passenger.App.Editors.FindBar">
    <!-- The find bar: across the top of the editor, the query with its toggles inside the field,
         the count and the arrows beside it, the replace row under it when replacing. On a tool window's ground, told
         from the editor under it by shade. -->
    <Border Background="{DynamicResource Passenger.Panel}" Padding="8,6">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <Panel Grid.Column="0" Width="380">
                <TextBox Name="Query" Classes="search" PlaceholderText="Find" Padding="8,4,96,4" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Spacing="1">
                    <ToggleButton Name="MatchCase" Classes="option" ToolTip.Tip="Match case">
                        <PathIcon Data="{StaticResource Icon.MatchCase}" />
                    </ToggleButton>
                    <ToggleButton Name="WholeWords" Classes="option" ToolTip.Tip="Words">
                        <PathIcon Data="{StaticResource Icon.WholeWord}" />
                    </ToggleButton>
                    <ToggleButton Name="UseRegex" Classes="option" ToolTip.Tip="Regex">
                        <TextBlock Text=".*" FontFamily="{x:Static editor:CodeEditor.CodeFont}" FontWeight="Bold" FontSize="12" />
                    </ToggleButton>
                </StackPanel>
            </Panel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Name="Count" Classes="muted" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Name="PreviousButton" Classes="tool" ToolTip.Tip="Previous occurrence">
                    <PathIcon Data="{StaticResource Icon.ArrowUp}" />
                </Button>
                <Button Name="NextButton" Classes="tool" ToolTip.Tip="Next occurrence">
                    <PathIcon Data="{StaticResource Icon.ArrowDown}" />
                </Button>
            </StackPanel>
            <Button Name="CloseButton" Grid.Column="2" Classes="tool" ToolTip.Tip="Close" VerticalAlignment="Center">
                <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
            </Button>
            <StackPanel Name="ReplaceRow" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="False">
                <TextBox Name="ReplaceWith" Classes="search" Width="380" PlaceholderText="Replace" Padding="8,4" />
                <Button Name="ReplaceButton" Content="Replace" />
                <Button Name="ReplaceAllButton" Content="Replace All" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
