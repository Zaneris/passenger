<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Passenger.App"
             xmlns:editors="using:Passenger.App.Editors"
             x:Class="Passenger.App.Editors.FindBar">
    <!-- The find bar: across the top of the editor, console or diff, the query with its toggles inside the field, the count,
         the arrows and Close after it, the replace row under it when replacing. Each row is the shared row that wraps
         (ToolFlow, made in FindBar's constructor): a field keeps room to type in, and what follows it takes a row below
         where the bar is too narrow for both. On a tool window's ground, told from the editor under it by shade. -->
    <Border Background="{DynamicResource Passenger.Panel}" Padding="{x:Static editors:FindBar.BarPadding}">
        <StackPanel Spacing="{x:Static app:Gaps.Small}">
            <Panel Name="QueryRow">
                <Panel Name="QueryRoom">
                    <TextBox Name="Query" Classes="search" PlaceholderText="Find" Padding="{x:Static editors:FindBar.QueryPadding}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{x:Static editors:FindBar.OptionsMargin}" Spacing="{x:Static app:Gaps.Hair}">
                        <ToggleButton Name="MatchCase" Classes="option" ToolTip.Tip="Match case" AutomationProperties.Name="Match case">
                            <PathIcon Data="{StaticResource Icon.MatchCase}" />
                        </ToggleButton>
                        <ToggleButton Name="WholeWords" Classes="option" ToolTip.Tip="Words" AutomationProperties.Name="Words">
                            <PathIcon Data="{StaticResource Icon.WholeWord}" />
                        </ToggleButton>
                        <ToggleButton Name="UseRegex" Classes="option" ToolTip.Tip="Regex" AutomationProperties.Name="Regex">
                            <TextBlock Name="RegexGlyph" Classes="badgeText" Text=".*" />
                        </ToggleButton>
                    </StackPanel>
                </Panel>
                <StackPanel Name="CountRow" Orientation="Horizontal" Spacing="{x:Static app:Gaps.Hair}" VerticalAlignment="Center">
                    <TextBlock Name="Count" Classes="muted" Margin="{x:Static editors:FindBar.CountMargin}" VerticalAlignment="Center" />
                    <Button Name="PreviousButton" Classes="tool" ToolTip.Tip="Previous occurrence" AutomationProperties.Name="Previous occurrence">
                        <PathIcon Data="{StaticResource Icon.ArrowUp}" />
                    </Button>
                    <Button Name="NextButton" Classes="tool" ToolTip.Tip="Next occurrence" AutomationProperties.Name="Next occurrence">
                        <PathIcon Data="{StaticResource Icon.ArrowDown}" />
                    </Button>
                </StackPanel>
                <Button Name="CloseButton" Classes="tool" ToolTip.Tip="Close" AutomationProperties.Name="Close" VerticalAlignment="Center">
                    <PathIcon Classes="small" Data="{StaticResource Icon.Close}" />
                </Button>
            </Panel>
            <Panel Name="ReplaceRow" IsVisible="False">
                <TextBox Name="ReplaceWith" Classes="search" PlaceholderText="Replace" />
                <StackPanel Name="ReplaceButtons" Orientation="Horizontal" Spacing="{x:Static app:Gaps.Small}">
                    <Button Name="ReplaceButton" Content="Replace" />
                    <Button Name="ReplaceAllButton" Content="Replace All" />
                </StackPanel>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>
