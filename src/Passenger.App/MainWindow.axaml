<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editors="using:Passenger.App.Editors"
        xmlns:docking="using:Passenger.App.Docking"
        xmlns:app="using:Passenger.App"
        x:Class="Passenger.App.MainWindow"
        Title="Passenger"
        Icon="/Assets/passenger.png"
        Width="1400" Height="900"
        MinWidth="{x:Static app:MainWindow.SmallestWidth}" MinHeight="{x:Static app:MainWindow.SmallestHeight}">
    <Window.Resources>
        <!-- Avalonia's own title bar, which Windows and Linux draw once the window extends into its frame: none of it is
             drawn, the toolbar being the title bar with the window's buttons its own. On Linux its frame is the resize
             grips' width; the window's edge lies inside it (MainWindow.TitleBar.cs). -->
        <ControlTheme x:Key="TitleBarDecorations" TargetType="WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="40" />
            <Setter Property="DefaultFrameThickness" Value="4" />
            <Setter Property="DefaultShadowThickness" Value="0" />
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <WindowDrawnDecorationsContent />
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>
    <Panel Name="Root" Background="{DynamicResource Passenger.Editor.Background}">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The toolbar, which is the window's title bar too (MainWindow.TitleBar.cs): its empty space moves the window and
             a double click on it maximizes, while what is on it takes its own clicks (the role User, where Windows asks). -->
        <Border Name="Toolbar" Classes="titleBar" Grid.Row="0" Height="40" PointerPressed="OnToolbarPressed">
            <DockPanel Name="ToolbarContent" Margin="8,0">
                <!-- The window's buttons at the bar's right on Windows and Linux; macOS's own stand at its left. Their
                     roles make Windows treat them as its caption buttons (its snap layouts on the maximize one). -->
                <StackPanel Name="WindowButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" IsVisible="False">
                    <Button Name="MinimizeButton" Classes="windowButton" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize"
                            WindowDecorationProperties.ElementRole="MinimizeButton" Click="OnMinimizeClicked">
                        <Path Data="M0,5.5 H10" />
                    </Button>
                    <Button Name="MaximizeButton" Classes="windowButton" AutomationProperties.Name="Maximize"
                            WindowDecorationProperties.ElementRole="MaximizeButton" Click="OnMaximizeClicked">
                        <Path Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                    </Button>
                    <Button Name="CloseButton" Classes="windowButton close" ToolTip.Tip="Close" AutomationProperties.Name="Close"
                            WindowDecorationProperties.ElementRole="CloseButton" Click="OnCloseClicked">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" />
                    </Button>
                </StackPanel>

                <!-- The run widget and the icons at the right keep their room as the window narrows: the project's and
                     branch's names give way first, ending in an ellipsis (the end group is laid out before the start
                     one). -->
                <StackPanel Name="ToolbarEnd" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            WindowDecorationProperties.ElementRole="User">
                    <Button Name="BuildButton" Classes="tool" ToolTip.Tip="Build solution">
                        <PathIcon Data="{StaticResource Icon.Build}" />
                    </Button>
                    <Button Name="RunConfigButton" Classes="widget" ToolTip.Tip="Run configuration" Click="OnRunConfigClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Name="RunConfigName" Text="No configurations" VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                        </StackPanel>
                    </Button>
                    <Button Name="RunButton" Classes="tool" ToolTip.Tip="Run">
                        <PathIcon Classes="toolbarRun" Data="{StaticResource Icon.Run}" />
                    </Button>
                    <Button Name="DebugButton" Classes="tool" ToolTip.Tip="Debug">
                        <PathIcon Data="{StaticResource Icon.Debug}" />
                    </Button>
                    <Button Name="ProfileButton" Classes="tool" ToolTip.Tip="Profile">
                        <PathIcon Data="{StaticResource Icon.Profile}" />
                    </Button>
                    <Button Name="HotReloadButton" Classes="tool" ToolTip.Tip="Apply Hot Reload Changes" IsVisible="False">
                        <PathIcon Classes="toolbarHotReload" Data="{StaticResource Icon.HotReload}" />
                    </Button>
                    <Button Name="StopButton" Classes="tool" ToolTip.Tip="Stop" IsEnabled="False">
                        <PathIcon Classes="toolbarStop" Data="{StaticResource Icon.Stop}" />
                    </Button>
                    <Border Classes="toolbarRule" />
                    <Button Name="SearchButton" Classes="tool" ToolTip.Tip="Search everywhere">
                        <PathIcon Data="{StaticResource Icon.Search}" />
                    </Button>
                    <Button Name="SettingsButton" Classes="tool" ToolTip.Tip="Settings">
                        <PathIcon Data="{StaticResource Icon.Settings}" />
                    </Button>
                </StackPanel>

                <app:ShrinkingRow Name="ToolbarStart" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                           WindowDecorationProperties.ElementRole="User">
                    <!-- The main menu, where the system has no menu bar of its own: behind a button, or as a bar of its
                         menus' titles (Settings' Show main menu as a menu bar), those the toolbar has no room for
                         behind the button after them. The titles are added after the button as Settings asks for
                         them. -->
                    <app:MainMenuPlace Name="MainMenuPlace" Margin="0,0,2,0">
                        <Button Name="MenuButton" Classes="tool" ToolTip.Tip="Main menu" Click="OnMenuClicked">
                            <PathIcon Data="{StaticResource Icon.Menu}" />
                        </Button>
                    </app:MainMenuPlace>
                    <Button Name="ProjectButton" Classes="widget" Margin="0,0,2,0" MinWidth="60" ToolTip.Tip="Open a solution, project or folder" Click="OnProjectClicked">
                        <DockPanel>
                            <Border Name="ProjectBadge" Classes="projectBadge" DockPanel.Dock="Left" Margin="0,0,7,0" IsVisible="False" Width="20" Height="20">
                                <TextBlock Name="ProjectBadgeText" Classes="projectBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <PathIcon DockPanel.Dock="Right" Margin="7,0,0,0" Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                            <TextBlock Name="ProjectName" Classes="projectName" Text="No solution" VerticalAlignment="Center"
                                       MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Name="BranchButton" Classes="widget" MinWidth="54" ToolTip.Tip="Version control" Click="OnBranchClicked">
                        <DockPanel>
                            <PathIcon DockPanel.Dock="Left" Margin="0,0,6,0" Data="{StaticResource Icon.Branch}" />
                            <PathIcon DockPanel.Dock="Right" Margin="6,0,0,0" Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                            <TextBlock Name="BranchName" Text="Version control" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </app:ShrinkingRow>
            </DockPanel>
        </Border>

        <!-- Tool windows round the editor: stripes of their buttons down both edges. -->
        <docking:DockHost Name="Dock" Grid.Row="1">
            <docking:DockHost.Center>
                <editors:EditorArea Name="Editors" />
            </docking:DockHost.Center>
        </docking:DockHost>

        <!-- The status bar: where the caret is and how the file is stored. -->
        <Border Classes="statusBar" Grid.Row="2">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <!-- A newer release: its download under way, Restart to Update once it is ready, or (for a copy that
                         cannot update itself) a link to this system's download or the release page, once per version. -->
                    <Button Name="UpdateButton" Classes="statusItem" IsVisible="False" Click="OnUpdateClicked">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Name="UpdateIcon" Data="{StaticResource Icon.ArrowDown}" Foreground="{DynamicResource Passenger.Link}" Width="12" Height="12" />
                            <TextBlock Name="UpdateText" Classes="status" Foreground="{DynamicResource Passenger.Link}" />
                        </StackPanel>
                    </Button>
                    <Button Name="AnalysisButton" Classes="statusItem" Click="OnAnalysisClicked">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Name="AnalysisIcon" Width="14" Height="14" />
                            <TextBlock Name="AnalysisText" Classes="status" />
                        </StackPanel>
                    </Button>
                    <Button Name="ErrorsButton" Classes="statusItem" IsVisible="False" Click="OnErrorsClicked"
                            ToolTip.Tip="IDE Internal Errors: Passenger caught these and kept running">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{DynamicResource Icon.Error}" Foreground="{DynamicResource Passenger.Error}" Width="14" Height="14" />
                            <TextBlock Name="ErrorsCount" Classes="status" Foreground="{DynamicResource Passenger.Error}" />
                        </StackPanel>
                    </Button>
                    <!-- Agents on the window: how many, what one runs, or a question one waits on, which stands out (the
                         accent's pill with a bell) and a click brings forward, since the person may not have seen it. -->
                    <Button Name="AgentButton" Classes="statusItem" IsVisible="False" Click="OnAgentClicked"
                            ToolTip.Tip="An agent is using this window through Passenger's MCP server">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Name="AgentIcon" Data="{StaticResource Icon.Notifications}" Width="12" Height="12" IsVisible="False" />
                            <TextBlock Name="AgentText" Classes="status" />
                        </StackPanel>
                    </Button>
                    <!-- The file's widgets: a click on the caret's place goes to a line, on the line separator, encoding or
                         indent offers the others. Their frames reach into the spacing, so their words stand where the
                         other items' do. -->
                    <Button Name="CaretButton" Classes="statusItem" Margin="-6,0" Focusable="False" IsVisible="False" Click="OnCaretClicked">
                        <TextBlock Name="CaretText" Classes="status" />
                    </Button>
                    <Button Name="LineSeparatorButton" Classes="statusItem" Margin="-6,0" Focusable="False" IsVisible="False" Click="OnLineSeparatorClicked">
                        <TextBlock Name="LineEndingText" Classes="status" />
                    </Button>
                    <Button Name="EncodingButton" Classes="statusItem" Margin="-6,0" Focusable="False" IsVisible="False" Click="OnEncodingClicked">
                        <TextBlock Name="EncodingText" Classes="status" />
                    </Button>
                    <Button Name="IndentButton" Classes="statusItem" Margin="-6,0" Focusable="False" IsVisible="False" Click="OnIndentClicked">
                        <TextBlock Name="IndentText" Classes="status" />
                    </Button>
                    <TextBlock Name="LanguageText" Classes="status" />
                </StackPanel>
                <!-- Cut where the widgets begin, so a deep file's path never runs on under them. -->
                <StackPanel Name="BreadcrumbHost" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" />
                <!-- What the status bar says, with whether it is an error or a warning (a project's load) while it says it;
                     a link to where it has more to see while it has a place (StatusBar.Say), its whole text on hover. -->
                <Button Name="StatusMessage" Classes="statusMessage">
                    <DockPanel>
                        <PathIcon Name="StatusIcon" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" IsVisible="False" VerticalAlignment="Center" />
                        <app:WorkingRing Name="StatusWorking" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" IsVisible="False" VerticalAlignment="Center" />
                        <TextBlock Name="StatusText" Classes="status" Text="No solution" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>

    <!-- Popups (Go to File, Go to Line) over everything; a click outside one dismisses it. -->
    <Panel Name="Overlay" IsVisible="False" Background="Transparent">
        <ContentControl Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0" />
    </Panel>
    </Panel>
</Window>
