<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows only. Avalonia needs it for window transparency and embedded controls, and Windows makes a layered child
       window (a reader's over an editor, UiaTextWindow) only for a process it names. -->
  <assemblyIdentity version="1.0.0.0" name="Passenger.App"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
