<Project>
  <!-- The packages of the GdUnit4 and GoDotTest tests the Godot tests write into a Godot 4 C# game, but Godot's own,
       downloaded with the solution's restore so the package cache holds them: a test's game restores from the Godot
       found's own packages alone, which finds the rest there (GdUnit4Tests, GoDotTestTests), never on nuget.org. Built as
       an empty library, never run, under none of the repo's rules, which are for Passenger's code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../../artifacts</ArtifactsPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
