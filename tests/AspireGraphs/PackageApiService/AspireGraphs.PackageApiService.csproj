<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The starter's API service as Aspire's templates at AspirePackageTemplatesVersion make it; a library, with no Main. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PackageServiceDefaults/AspireGraphs.PackageServiceDefaults.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" VersionOverride="$(AspirePackageOpenApiVersion)" />
  </ItemGroup>
</Project>
