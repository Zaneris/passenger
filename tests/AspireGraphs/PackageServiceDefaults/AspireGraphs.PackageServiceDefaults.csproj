<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aspire's ServiceDefaults as its templates at AspirePackageTemplatesVersion make it, at the versions they write. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" VersionOverride="$(AspirePackageOpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" VersionOverride="$(AspirePackageOpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" VersionOverride="$(AspirePackageOpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" VersionOverride="$(AspirePackageOpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" VersionOverride="$(AspirePackageOpenTelemetryVersion)" />
  </ItemGroup>
</Project>
