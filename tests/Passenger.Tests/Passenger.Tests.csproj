<Project Sdk="Microsoft.NET.Sdk">
  <!-- The IDE driven whole, headless, through real keyboard and mouse input. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Passenger.Tests</RootNamespace>
    <!-- The rig's LibraryImports (the run's nice value), and FileTests' (a Linux file's extended attributes). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- dotnet test's results (VSTest's folder for each run, a .trx, a hang's dump) under artifacts/ with the builds, never
         beside the sources, where VSTest puts them by default; CI's test.yml names the same folder. -->
    <VSTestResultsDirectory>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'test-results'))</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/Passenger.App/Passenger.App.csproj" />
    <ProjectReference Include="../../src/Passenger.Lsp/Passenger.Lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia's media context, whose fields a settle reads, as Passenger's hooks into an Avalonia program read it. -->
    <Compile Include="../../src/Passenger.Inspector/AvaloniaHooks.cs" Link="AvaloniaHooks.cs" />
    <!-- The inspector's frame events, which a test tells as an app's inspector does. -->
    <Compile Include="../../src/Passenger.Inspector/FrameWire.cs" Link="FrameWire.cs" />
  </ItemGroup>

  <!-- Avalonia's templates, restored from nuget.org as every package is and served to the tests from the package cache
       as a local feed (AvaloniaApp.Feed), so installing them never reaches nuget.org at test time. -->
  <ItemGroup>
    <PackageDownload Include="Avalonia.Templates" Version="[$(AvaloniaTemplatesVersion)]" />
    <PackageDownload Include="Aspire.ProjectTemplates" Version="[$(AspireTemplatesVersion)]" />
    <PackageDownload Include="Aspire.AppHost.Sdk" Version="[$(AspireTemplatesVersion)]" />
    <AssemblyMetadata Include="NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
    <AssemblyMetadata Include="AvaloniaTemplatesVersion" Value="$(AvaloniaTemplatesVersion)" />
    <AssemblyMetadata Include="AvaloniaOlderVersion" Value="$(AvaloniaOlderVersion)" />
    <AssemblyMetadata Include="AspireTemplatesVersion" Value="$(AspireTemplatesVersion)" />
  </ItemGroup>

  <!-- Aspire's dashboard and orchestrator (DCP) for this machine, about 900 MB in the package cache, which only a test
       that runs an AppHost needs: downloaded where PassengerAspireRuntime is true (a property, or an environment variable of
       that name, which the person or CI sets). Without them every AppHost the run restores leaves them out (the
       Directory.Build.targets AspireApp.UseFeed writes), and a test that would run one skips, saying how to have them
       (AspireApp.Unavailable). -->
  <PropertyGroup>
    <PassengerAspireRuntime Condition="'$(PassengerAspireRuntime)' != 'true'">false</PassengerAspireRuntime>
  </PropertyGroup>
  <ItemGroup Condition="'$(PassengerAspireRuntime)' == 'true'">
    <PackageDownload Include="Aspire.Dashboard.Sdk.$(NETCoreSdkRuntimeIdentifier)" Version="[$(AspireTemplatesVersion)]" />
    <PackageDownload Include="Aspire.Hosting.Orchestration.$(NETCoreSdkRuntimeIdentifier)" Version="[$(AspireTemplatesVersion)]" />
  </ItemGroup>
  <!-- And on macOS and Linux the aspire CLI of the run's own (native, about 150 MB, its bundle of 350 MB more unpacked
       beside it as first run), which the run puts on its PATH behind a wrapper that gives it a home of the run's own
       (TestRun): the tests never run the person's. On Windows an AppHost and the CLI keep their record of running AppHosts in
       the person's profile whatever the environment says, so there the tests that would run one skip. -->
  <ItemGroup Condition="'$(PassengerAspireRuntime)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageDownload Include="Aspire.Cli.$(NETCoreSdkRuntimeIdentifier)" Version="[$(AspireTemplatesVersion)]" />
    <AssemblyMetadata Include="AspireCli" Value="$(NuGetPackageRoot)aspire.cli.$(NETCoreSdkRuntimeIdentifier.ToLowerInvariant())/$(AspireTemplatesVersion)/tools/net10.0/$(NETCoreSdkRuntimeIdentifier)/aspire" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AspireRuntime" Value="$(PassengerAspireRuntime)" />
  </ItemGroup>

  <!-- The package graphs of the AppHosts, ServiceDefaults and services the Aspire tests write, in the package cache before
       they run (tests/AspireGraphs): restored and built first, never linked. -->
  <ItemGroup>
    <ProjectReference Include="../AspireGraphs/AppHost/AspireGraphs.AppHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../AspireGraphs/ServiceDefaults/AspireGraphs.ServiceDefaults.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../AspireGraphs/ApiService/AspireGraphs.ApiService.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The package graph of the EF Core projects the Migrations window's tests write (tests/EfGraphs), and the dotnet-ef
       tool at EF Core's version and the one before, in the package cache before they run, copied into the run's local
       feed from there (MigrationsTests). -->
  <ItemGroup>
    <ProjectReference Include="../EfGraphs/Sqlite/EfGraphs.Sqlite.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../EfGraphs/SqliteOlder/EfGraphs.SqliteOlder.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../EfGraphs/Npgsql/EfGraphs.Npgsql.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../EfGraphs/Sqlite11/EfGraphs.Sqlite11.csproj" ReferenceOutputAssembly="false" />
    <PackageDownload Include="dotnet-ef" Version="[$(EfCoreVersion)];[$(EfCoreOlderVersion)];[$(EfCore11Version)]" />
    <AssemblyMetadata Include="EfCoreVersion" Value="$(EfCoreVersion)" />
    <AssemblyMetadata Include="EfCoreOlderVersion" Value="$(EfCoreOlderVersion)" />
    <AssemblyMetadata Include="EfCore11Version" Value="$(EfCore11Version)" />
    <AssemblyMetadata Include="NpgsqlEfVersion" Value="$(NpgsqlEfVersion)" />
  </ItemGroup>

  <!-- VSTest's SDK and xunit's adapter at the versions this project restores, for the VSTest project TestFramesTests make
       (HeadlessTestsFolder): the run's feed holds neither, so its restore finds them only in the package cache. -->
  <ItemGroup>
    <AssemblyMetadata Include="TestSdkVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.NET.Test.Sdk')->'%(Version)')" />
    <AssemblyMetadata Include="XunitRunnerVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'xunit.runner.visualstudio')->'%(Version)')" />
    <!-- OpenTelemetry's, which the AspireGraphs' ServiceDefaults restore puts in the package cache, for ContainerTelemetryTests' app. -->
    <AssemblyMetadata Include="OpenTelemetryVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'OpenTelemetry.Extensions.Hosting')->'%(Version)')" />
  </ItemGroup>

  <!-- WPF's reference pack, likewise, for the WPF app WpfXamlTests make (WpfApp.Feed), with the target they make it for
       and the version the SDK's own WPF needs there, which the tests check against the one pinned. -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[$(WindowsDesktopRefVersion)]" />
    <AssemblyMetadata Include="WindowsDesktopRefVersion" Value="$(WindowsDesktopRefVersion)" />
    <AssemblyMetadata Include="TargetFramework" Value="$(TargetFramework)" />
  </ItemGroup>
  <!-- This machine's .NET runtime pack at the SDK's own version, for the self-contained app PublishTests publish for this
       system at the tests' own target: its restore finds the pack in the package cache, never reaching nuget.org. -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.$(NETCoreSdkRuntimeIdentifier)" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>
  <Target Name="SdkWindowsDesktopRefVersion" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="SdkWindowsDesktopRefVersion"
                        Value="@(KnownFrameworkReference->WithMetadataValue('Identity', 'Microsoft.WindowsDesktop.App')->WithMetadataValue('TargetFramework', '$(TargetFramework)')->'%(TargetingPackVersion)')" />
    </ItemGroup>
  </Target>

  <!-- The project's own ESLint and Prettier that EslintPrettierTests put in a test folder's node_modules: npm packages
       NodePackages/package.json pins and package-lock.json locks, each tarball with its sha512, put in place at build by
       tools/Passenger.NodePackages (no Node.js, cached in artifacts/node/cache) under node-packages/ in the tests' output;
       no test reaches npm's registry. To move a pin, change package.json, have npm write the lock again (npm install with
       its package-lock-only and ignore-scripts options), and bring THIRD_PARTY_NOTICES.md's tests' table along. -->
  <PropertyGroup>
    <TestNodeLock>$(MSBuildThisFileDirectory)NodePackages/package-lock.json</TestNodeLock>
    <TestNodeRoot>$([MSBuild]::EnsureTrailingSlash('$(ArtifactsPath)'))node/</TestNodeRoot>
    <TestNodeFolder>$(TestNodeRoot)tests/</TestNodeFolder>
    <TestNodeStamp>$(TestNodeRoot)tests.stamp</TestNodeStamp>
    <TestNodeArguments>$(TestNodeRoot)tests.arguments</TestNodeArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/Passenger.NodePackages/Passenger.NodePackages.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun" />
  </ItemGroup>
  <Target Name="WriteTestNodeArguments">
    <MSBuild Projects="../../tools/Passenger.NodePackages/Passenger.NodePackages.csproj" Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="TestNodePackagesTool" />
    </MSBuild>
    <ItemGroup>
      <TestNodeLine Include="lock=$(TestNodeLock)" />
      <TestNodeLine Include="cache=$(TestNodeRoot)cache" />
      <TestNodeLine Include="out=$(TestNodeFolder)" />
      <TestNodeLine Include="stamp=$(TestNodeStamp)" />
    </ItemGroup>
    <MakeDir Directories="$(TestNodeRoot)" />
    <WriteLinesToFile File="$(TestNodeArguments)" Lines="@(TestNodeLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="FetchTestNodePackages" DependsOnTargets="WriteTestNodeArguments"
          Inputs="$(TestNodeLock);$(TestNodeArguments);@(TestNodePackagesTool)" Outputs="$(TestNodeStamp)">
    <PropertyGroup>
      <TestNodeHost>$(DOTNET_HOST_PATH)</TestNodeHost>
      <TestNodeHost Condition="'$(TestNodeHost)' == ''">dotnet</TestNodeHost>
    </PropertyGroup>
    <Exec Command="&quot;$(TestNodeHost)&quot; &quot;@(TestNodePackagesTool)&quot; &quot;$(TestNodeArguments)&quot;" />
  </Target>
  <Target Name="IncludeTestNodePackages" BeforeTargets="AssignTargetPaths" DependsOnTargets="FetchTestNodePackages">
    <ItemGroup>
      <TestNodeFile Include="$(TestNodeFolder)node_modules/**/*" />
      <None Include="@(TestNodeFile)" Link="node-packages/node_modules/%(TestNodeFile.RecursiveDir)%(TestNodeFile.Filename)%(TestNodeFile.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- A test drives the IDE whole or a real process through its real boundary: the entry points a unit test would call
       instead are banned (BannedSymbols.txt), as is hearing a child past ChildProcesses.Hear, which warnings as errors
       make a failed build. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The debugger's tests: the programs they debug, built first and never linked, and the diagnostics
       client that lets a program started suspended go on. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <ProjectReference Include="../../src/Passenger.Dap/Passenger.Dap.csproj" />
    <ProjectReference Include="../Debuggees/AsyncEntryConsoleApp/AsyncEntryConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/AsyncTopLevelStatementsConsoleApp/AsyncTopLevelStatementsConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/DebuggableConsoleApp/DebuggableConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/LoopingConsoleApp/LoopingConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/LoopingConsoleAppOptimized/LoopingConsoleAppOptimized.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/PassengerCases/PassengerCases.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/ReadsInputConsoleApp/ReadsInputConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/ReadsInputConsoleAppNoCet/ReadsInputConsoleAppNoCet.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/RuntimeAsyncConsoleApp/RuntimeAsyncConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/StateMachineAsyncConsoleApp/StateMachineAsyncConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/SteppingConsoleApp/SteppingConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/TerminalConsoleApp/TerminalConsoleApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/TerminalCases/TerminalCases.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Debuggees/TopLevelStatementsConsoleApp/TopLevelStatementsConsoleApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
