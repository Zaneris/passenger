// Lantern: a small dark VS Code colour theme written for Passenger's tests, its comment too faint to read on purpose.
{
  "name": "Lantern",
  "type": "dark",
  "semanticHighlighting": true,
  "include": "./lantern-base.json",
  "colors": {
    "editor.background": "#1F1D2B",
    "editor.foreground": "#ECE7F5",
    "editor.lineHighlightBackground": "#FFFFFF0D",
    "editor.selectionBackground": "#4A3F6B",
    "editorCursor.foreground": "#FFB86B",
    "sideBar.background": "#191724",
    "editorGroupHeader.tabsBackground": "#13111C",
    "titleBar.activeBackground": "#13111C",
    "titleBar.activeForeground": "#B9B2CC",
    "button.background": "#8E6CEF",
    "button.foreground": "#FFFFFF",
    "focusBorder": "#FFB86B",
    "list.activeSelectionBackground": "#3A3157",
    "terminal.ansiRed": "#FF6E8A",
    "terminal.ansiGreen": "#7BE0A0",
    "terminal.ansiYellow": "#F5D67B",
    "terminal.ansiBlue": "#7AA7FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#6FD6E0",
    "editorBracketHighlight.foreground1": "#F5D67B",
    "editorBracketHighlight.foreground2": "#C792EA",
    "editorBracketHighlight.foreground3": "#7AA7FF",
    "editorBracketHighlight.foreground4": "#FF9E64",
    "editorBracketHighlight.foreground5": "#7BE0A0",
    "editorBracketHighlight.foreground6": "#3A3557",
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#4E4A63", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.modifier", "storage.type"], "settings": { "foreground": "#C792EA" } },
    { "scope": "string", "settings": { "foreground": "#F5D67B" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#FF9E64" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7AA7FF" } },
    { "scope": ["entity.name.type", "support.class"], "settings": { "foreground": "#6FD6E0" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#FFB86B", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#C792EA" } },
  ],
  "semanticTokenColors": { "property": "#E9A8D2" },
}
