<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BindingValuesApp.DetailsWindow"
        x:CompileBindings="False"
        Title="Details" Width="240" Height="120">
    <TextBlock x:Name="Note" Text="{Binding Note}" />
</Window>
