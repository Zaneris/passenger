<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- C# 15's unions, and a pointer. -->
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../PassengerCasesProxies/PassengerCasesProxies.csproj" />
		<!-- One file compiled into this program and into the library, which the program also loads into contexts of its own. -->
		<Compile Include="../LinkedLibrary/Linked.cs" Link="Linked.cs" />
		<ProjectReference Include="../LinkedLibrary/LinkedLibrary.csproj" />
	</ItemGroup>

</Project>
