<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic tested alone, fast and the same on every run and system: no window, no Avalonia, no process, no network,
       no clock, and no file system but a temporary folder where the logic is about paths. What a person does is tested
       whole in Passenger.Tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Passenger.UnitTests</RootNamespace>
    <!-- dotnet test's results under artifacts/ with the builds, as Passenger.Tests' are. -->
    <VSTestResultsDirectory>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'test-results'))</VSTestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/Passenger.Core/Passenger.Core.csproj" />
    <ProjectReference Include="../../src/Passenger.Dap/Passenger.Dap.csproj" />
    <ProjectReference Include="../../src/Passenger.Debugger/Passenger.Debugger.csproj" />
    <ProjectReference Include="../../src/Passenger.Packages/Passenger.Packages.csproj" />
    <ProjectReference Include="../../src/Passenger.Profiler/Passenger.Profiler.csproj" />
    <ProjectReference Include="../../src/Passenger.Terminal/Passenger.Terminal.csproj" />
    <ProjectReference Include="../../src/Passenger.Text/Passenger.Text.csproj" />
    <ProjectReference Include="../../src/Passenger.Vcs/Passenger.Vcs.csproj" />
    <ProjectReference Include="../../src/Passenger.Workspace/Passenger.Workspace.csproj" />
    <ProjectReference Include="../../src/Passenger.Xaml/Passenger.Xaml.csproj" />
    <ProjectReference Include="../../tools/Passenger.NodePackages/Passenger.NodePackages.csproj" />
  </ItemGroup>

  <!-- What the container runs read of Compose's and Docker's files, as text and paths alone, compiled in since their
       project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Containers/ComposeFiles.cs" Link="App/ComposeFiles.cs" />
    <Compile Include="../../src/Passenger.App/Containers/ContainerPaths.cs" Link="App/ContainerPaths.cs" />
    <Compile Include="../../src/Passenger.App/Containers/DockerRunWords.cs" Link="App/DockerRunWords.cs" />
    <Compile Include="../../src/Passenger.App/Containers/DockerfileStages.cs" Link="App/DockerfileStages.cs" />
  </ItemGroup>

  <!-- What a launch handed to a running Passenger says, written and read as JSON alone, compiled in since its project is
       the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/HandedLaunch.cs" Link="App/HandedLaunch.cs" />
  </ItemGroup>

  <!-- What .NET's browser debug proxy says of a stop and its values, read as JSON alone, compiled in since its project is
       the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Debugging/WebAssemblyValues.cs" Link="App/WebAssemblyValues.cs" />
  </ItemGroup>

  <!-- What a web app's build says it serves while it is developed, read as JSON alone, compiled in since its project is the
       app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Debugging/DevelopmentAssets.cs" Link="App/DevelopmentAssets.cs" />
  </ItemGroup>

  <!-- How XAML Hot Reload compares two texts of a XAML file's root, compiled in since its project is the inspector, which
       an app loads. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.Inspector/XamlRoot.cs" Link="Inspector/XamlRoot.cs" />
  </ItemGroup>

  <!-- Where an AppHost's dashboard is called from where it listens, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Aspire/DashboardAddress.cs" Link="App/DashboardAddress.cs" />
  </ItemGroup>

  <!-- What tells a program to send a dashboard its logs and traces over what it sets itself, compiled in since its project is
       the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Telemetry/OtlpEnvironment.cs" Link="App/OtlpEnvironment.cs" />
  </ItemGroup>

  <!-- What Safe Delete takes out of a C# file, read from Roslyn's syntax alone, compiled in since its project's editor
       brings Avalonia. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.Languages/CSharp/ParsedText.cs" Link="Languages/ParsedText.cs" />
    <Compile Include="../../src/Passenger.Languages/CSharp/SafeDeletion.cs" Link="Languages/SafeDeletion.cs" />
  </ItemGroup>

  <!-- Where a live template may go, where completion opens on a space and which lines begin inside a string, read from
       Roslyn's syntax alone, compiled in since their project's editor brings Avalonia. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.Languages/CSharp/TemplateScope.cs" Link="Languages/TemplateScope.cs" />
    <Compile Include="../../src/Passenger.Languages/CSharp/CompletionTriggers.cs" Link="Languages/CompletionTriggers.cs" />
    <Compile Include="../../src/Passenger.Languages/CSharp/StringLines.cs" Link="Languages/StringLines.cs" />
  </ItemGroup>

  <!-- What an MSBuild file's elements say, read from its markup alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/MSBuild/MSBuildSyntax.cs" Link="App/MSBuildSyntax.cs" />
  </ItemGroup>

  <!-- The bindings an .axaml file writes, read from its markup alone, compiled in since their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/LiveTree/XamlBindings.cs" Link="App/XamlBindings.cs" />
  </ItemGroup>

  <!-- What tells a breakpoint change worth sending to the debugger, read from its fields alone, compiled in since its
       project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Debugging/Signatures.cs" Link="App/Signatures.cs" />
  </ItemGroup>

  <!-- Where a breakpoint in Avalonia XAML stops, read from the file's markup alone, compiled in since its project is the
       app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Debugging/XamlBreakpoints.cs" Link="App/XamlBreakpoints.cs" />
  </ItemGroup>

  <!-- How a CSV's records and a workbook's cells are read and sorted, from their text and zip alone, compiled in since
       their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Tables/Table.cs" Link="App/Table.cs" />
    <Compile Include="../../src/Passenger.App/Tables/Workbook.cs" Link="App/Workbook.cs" />
    <Compile Include="../../src/Passenger.App/Tables/CellFormat.cs" Link="App/CellFormat.cs" />
    <Compile Include="../../src/Passenger.App/Tables/TableSort.cs" Link="App/TableSort.cs" />
  </ItemGroup>

  <!-- How the Endpoints window reads an .http file, holds an answer to its criteria and sends a request to a running app,
       from their text alone, compiled in since their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Endpoints/HttpFile.cs" Link="App/HttpFile.cs" />
    <Compile Include="../../src/Passenger.App/Endpoints/Expectation.cs" Link="App/Expectation.cs" />
    <Compile Include="../../src/Passenger.App/Endpoints/EndpointClient.cs" Link="App/EndpointClient.cs" />
    <Compile Include="../../src/Passenger.App/Endpoints/HttpVariables.cs" Link="App/HttpVariables.cs" />
    <Compile Include="../../src/Passenger.App/Endpoints/RouteRequests.cs" Link="App/RouteRequests.cs" />
    <Compile Include="../../src/Passenger.Roslyn.Extension/Messages.cs" Link="App/RoslynMessages.cs" />
  </ItemGroup>

  <!-- How a language server's messages are followed for the protocol trace, from their bytes alone, compiled in since
       their project carries the servers. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.Lsp/TracedStream.cs" Link="Lsp/TracedStream.cs" />
  </ItemGroup>

  <!-- Where a launch profile's browser opens, read from its URLs alone, the Node.js versions a package.json's engines
       range takes, read from its text alone, a game's copies' names and arguments, and whether a project's inputs changed
       since a build began, read from a temporary folder, compiled in since their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Run/LaunchProfile.cs" Link="App/LaunchProfile.cs" />
    <Compile Include="../../src/Passenger.App/Run/GameCopies.Names.cs" Link="App/GameCopies.Names.cs" />
    <Compile Include="../../src/Passenger.App/Web/NpmRange.cs" Link="App/NpmRange.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotServerWords.cs" Link="App/GodotServerWords.cs" />
    <Compile Include="../../src/Passenger.App/Testing/GutRuns.cs" Link="App/GutRuns.cs" />
    <Compile Include="../../src/Passenger.App/Testing/GoDotTests.cs" Link="App/GoDotTests.cs" />
    <Compile Include="../../src/Passenger.App/Testing/GdUnit4Settings.cs" Link="App/GdUnit4Settings.cs" />
    <Compile Include="../../src/Passenger.App/Testing/GdUnit4Log.cs" Link="App/GdUnit4Log.cs" />
    <Compile Include="../../src/Passenger.App/Testing/GodotStart.cs" Link="App/GodotStart.cs" />
    <Compile Include="../../src/Passenger.App/Run/BuiltInputs.cs" Link="App/BuiltInputs.cs" />
  </ItemGroup>

  <!-- What a publish profile is written with for the Publish dialog's options, from their values alone, compiled in since
       its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Run/PublishOptions.cs" Link="App/PublishOptions.cs" />
  </ItemGroup>

  <!-- Whether a new solution's or project's name can be one, from the name alone, compiled in since its project is the
       app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Templates/ProjectNames.cs" Link="App/ProjectNames.cs" />
  </ItemGroup>

  <!-- Godot's remote debug protocol, its Variant encoding and messages, from their bytes alone, the names Passenger's
       helper in a game is sent, and what a game's C# and its scenes say of each other, compiled in since their project is
       the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Godot/GodotVariant.cs" Link="App/GodotVariant.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotMessages.cs" Link="App/GodotMessages.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotScriptStops.cs" Link="App/GodotScriptStops.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotAgent.cs" Link="App/GodotAgent.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotEditorWire.cs" Link="App/GodotEditorWire.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotRelay.cs" Link="App/GodotRelay.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotChecks.cs" Link="App/GodotChecks.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotOffer.cs" Link="App/GodotOffer.cs" />
  </ItemGroup>

  <!-- The user folders a Godot's environment takes where it sets none, from the variables alone, compiled in since its
       project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Godot/GodotUserFolders.cs" Link="App/GodotUserFolders.cs" />
  </ItemGroup>

  <!-- How the properties pane edits a running game's values and where Keep writes one, from a property's hint and the
       scenes' and scripts' texts alone, and how a console folds Godot's errors, from their text alone, compiled in since
       their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Godot/GodotHints.cs" Link="App/GodotHints.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotText.cs" Link="App/GodotText.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotKeep.cs" Link="App/GodotKeep.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotConsoleFold.cs" Link="App/GodotConsoleFold.cs" />
    <Compile Include="../../src/Passenger.Languages/CSharp/CSharpParsing.cs" Link="Languages/CSharpParsing.cs" />
  </ItemGroup>

  <!-- A running game's values in the code: the members a script's file declares, the helper's answer, a value's words and
       its last minute, from texts and values alone, compiled in since their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Godot/GodotMembers.cs" Link="App/GodotMembers.cs" />
    <Compile Include="../../src/Passenger.App/Godot/GodotLiveReads.cs" Link="App/GodotLiveReads.cs" />
  </ItemGroup>

  <!-- A Godot class's or member's place in Godot's class reference, and what a GDScript card names, from names and texts
       alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Godot/GodotDocs.cs" Link="App/GodotDocs.cs" />
  </ItemGroup>

  <!-- What a program's output says of its serving, from its lines alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Run/ListeningLines.cs" Link="App/ListeningLines.cs" />
  </ItemGroup>

  <!-- How a build's lines name its problems, from their text alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Run/Building.cs" Link="App/Building.cs" />
  </ItemGroup>

  <!-- How an agent's answer cuts what runs long, from the values and lists alone, compiled in since its project is the
       app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Mcp/AgentAnswers.cs" Link="App/AgentAnswers.cs" />
  </ItemGroup>

  <!-- The command lines Settings give an agent to add Passenger with, from the executable's path and the shell alone,
       compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Mcp/AgentSetup.cs" Link="App/AgentSetup.cs" />
  </ItemGroup>

  <!-- Where a copy of a source generator's code goes and whose project it is, from their names alone, and what a C# file
       declares, from its syntax alone, compiled in since their project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/CSharp/GeneratedCopies.cs" Link="App/GeneratedCopies.cs" />
    <Compile Include="../../src/Passenger.App/CSharp/Declarations.cs" Link="App/Declarations.cs" />
  </ItemGroup>

  <!-- Which problems Problems' filter shows, from their fields alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/ToolWindows/ProblemFilter.cs" Link="App/ProblemFilter.cs" />
  </ItemGroup>

  <!-- Which files the Explorer's filter shows, from their paths alone, compiled in since its project is the app's. -->
  <ItemGroup>
    <Compile Include="../../src/Passenger.App/Explorer/ExplorerFilter.cs" Link="App/ExplorerFilter.cs" />
  </ItemGroup>

  <!-- The JSON schemas the app carries under web/schemas, compiled in for the checks of what they offer and take. -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/Passenger.Lsp/WebServers/schemas/*.json" LogicalName="schemas/%(Filename)%(Extension)"
                      Link="Schemas/Carried/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
