<Project>
  <!-- What every project shares. A project's own file sets only what is its own. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- The version, until a vX.Y.Z tag on the commit names it. -->
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The rules of global.json's SDK, .NET 11's: latest would take each newer SDK's own, failing a build that passed. -->
    <AnalysisLevel>11.0</AnalysisLevel>
    <!-- Every build lands under artifacts/, never beside the sources. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Passenger is in English; Roslyn's translated messages would only add folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Each project's packages.lock.json pins every package, transitive ones included, to the content hash restored.
         A restore on a person's machine rewrites it when a package changes (commit it with the change); CI restores
         only what it names. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Every system Passenger is published for (the musl pair for the container tools alone), so each lock file holds
         their packages and a publish restores what is locked, which CI's locked restore needs, and builds every library
         for its system, Roslyn's server included. Their runtime and host packs download only for a publish, and ASP.NET
         Core's, which nothing uses, never. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
    <EnableRuntimePackDownload Condition="'$(RuntimeIdentifier)' == ''">false</EnableRuntimePackDownload>
    <EnableAppHostPackDownload Condition="'$(RuntimeIdentifier)' == ''">false</EnableAppHostPackDownload>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <!-- Passenger's own rules (src/Passenger.Analyzers) over every project but theirs, as an analyzer alone: nothing of it
       is referenced or carried. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Passenger.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Passenger.Analyzers/Passenger.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Passenger's own code writes a whole file only through AtomicFile, FileText.Save or OwnFiles: File.WriteAll* is
       banned under src/ (src/BannedSymbols.txt), which warnings as errors make a failed build. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/BannedSymbols.txt" />
  </ItemGroup>
</Project>
