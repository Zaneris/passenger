<Project Sdk="Microsoft.NET.Sdk">
  <!-- Puts the npm packages a package-lock.json pins into a folder, each tarball checked against the sha512 the lock file
       gives it: a tool of the build, never part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Passenger.NodePackages</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The file the build hands it, read as the other build tools read theirs, and JSON as every program's is. -->
    <Compile Include="../Shared/InputsFile.cs" Link="InputsFile.cs" />
    <Compile Include="../../src/Passenger.Core/JsonMembers.cs" Link="JsonMembers.cs" />
  </ItemGroup>
</Project>
