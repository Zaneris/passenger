<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the notices the app carries (THIRD-PARTY-NOTICES.txt) from the packages it carries: a tool of the build,
       never part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Passenger.Notices</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The file the build hands it, read as the other build tools read theirs, and JSON as every program's is. -->
    <Compile Include="../Shared/InputsFile.cs" Link="InputsFile.cs" />
    <Compile Include="../../src/Passenger.Core/JsonMembers.cs" Link="JsonMembers.cs" />
  </ItemGroup>
</Project>
